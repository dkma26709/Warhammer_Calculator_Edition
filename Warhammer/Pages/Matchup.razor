@page "/"
@page "/matchup"

@using Warhammer.Models.Domain
@using Warhammer.Models.Enums
@using Warhammer.Models.Json
@using Warhammer.Calculator.Models
@using Warhammer.Services

@inject IGameDataRepository Repo
@inject CombatEngine CombatEngine

<div class="container-fluid py-3">
    <div class="row g-3">
        @* Attacker Panel *@
        <div class="col-md-5">
            <UnitPanel Label="Attacker"
                       SelectedFactionKey="@_attackerFactionKey"
                       OnFactionSelected="OnAttackerFactionSelected"
                       FactionUnits="@_attackerFactionUnits"
                       FactionExtras="@_attackerExtras"
                       SelectedUnit="@_attackerUnit"
                       OnUnitSelected="OnAttackerUnitSelected"
                       Configuration="@_attackerConfig"
                       ConfigurationChanged="OnAttackerConfigChanged" />
        </div>

        @* Combat Controls (center) *@
        <div class="col-md-2 d-flex flex-column align-items-center justify-content-center">
            <CombatControls ChargeState="@_chargeState"
                            ChargeStateChanged="OnChargeStateChanged"
                            Iterations="@_iterations"
                            IterationsChanged="OnIterationsChanged"
                            CanSimulate="@(_attackerConfig != null && _defenderConfig != null)"
                            IsSimulating="@_isSimulating"
                            OnSimulate="RunSimulation" />
        </div>

        @* Defender Panel *@
        <div class="col-md-5">
            <UnitPanel Label="Defender"
                       SelectedFactionKey="@_defenderFactionKey"
                       OnFactionSelected="OnDefenderFactionSelected"
                       FactionUnits="@_defenderFactionUnits"
                       FactionExtras="@_defenderExtras"
                       SelectedUnit="@_defenderUnit"
                       OnUnitSelected="OnDefenderUnitSelected"
                       Configuration="@_defenderConfig"
                       ConfigurationChanged="OnDefenderConfigChanged" />
        </div>
    </div>

    @* Effective Stats *@
    @if (_attackerConfig != null && _defenderConfig != null)
    {
        <div class="row">
            <div class="col-12">
                <EffectiveStatsPanel Attacker="_attackerConfig"
                                     Defender="_defenderConfig"
                                     ChargeState="_chargeState" />
            </div>
        </div>
    }

    @* Results *@
    @if (_result != null)
    {
        <div class="row mt-4">
            <div class="col-12">
                <ResultsPanel Result="_result"
                              AttackerName="@(_attackerUnit?.Name ?? "Attacker")"
                              DefenderName="@(_defenderUnit?.Name ?? "Defender")"
                              AttackerConfig="_attackerConfig"
                              DefenderConfig="_defenderConfig" />
            </div>
        </div>
    }
</div>

@code {
    // --- Attacker state ---
    private string? _attackerFactionKey;
    private IReadOnlyList<Unit>? _attackerFactionUnits;
    private FactionExtrasData? _attackerExtras;
    private Unit? _attackerUnit;
    private UnitConfiguration? _attackerConfig;

    // --- Defender state ---
    private string? _defenderFactionKey;
    private IReadOnlyList<Unit>? _defenderFactionUnits;
    private FactionExtrasData? _defenderExtras;
    private Unit? _defenderUnit;
    private UnitConfiguration? _defenderConfig;

    // --- Combat ---
    private ChargeState _chargeState = ChargeState.Neither;
    private int _iterations = 10_000;
    private CombatSimulationResult? _result;
    private bool _isSimulating;

    protected override async Task OnInitializedAsync()
    {
        await Repo.EnsureLoadedAsync();
    }

    // --- Attacker events ---
    private async Task OnAttackerFactionSelected(string factionKey)
    {
        _attackerFactionKey = factionKey;
        _attackerUnit = null;
        _attackerConfig = null;
        _result = null;

        if (!string.IsNullOrEmpty(factionKey) && FactionKeyExtensions.TryFromJsonKey(factionKey, out var fk))
        {
            _attackerFactionUnits = await Repo.GetUnitsAsync(fk);
            _attackerExtras = await Repo.GetFactionExtrasAsync(fk);
        }
        else
        {
            _attackerFactionUnits = null;
            _attackerExtras = null;
        }
    }

    private void OnAttackerUnitSelected(Unit? unit)
    {
        _attackerUnit = unit;
        _attackerConfig = unit != null ? new UnitConfiguration(unit) : null;
        _result = null;
    }

    private void OnAttackerConfigChanged(UnitConfiguration config)
    {
        _attackerConfig = config;
        _result = null;
    }

    // --- Defender events ---
    private async Task OnDefenderFactionSelected(string factionKey)
    {
        _defenderFactionKey = factionKey;
        _defenderUnit = null;
        _defenderConfig = null;
        _result = null;

        if (!string.IsNullOrEmpty(factionKey) && FactionKeyExtensions.TryFromJsonKey(factionKey, out var fk))
        {
            _defenderFactionUnits = await Repo.GetUnitsAsync(fk);
            _defenderExtras = await Repo.GetFactionExtrasAsync(fk);
        }
        else
        {
            _defenderFactionUnits = null;
            _defenderExtras = null;
        }
    }

    private void OnDefenderUnitSelected(Unit? unit)
    {
        _defenderUnit = unit;
        _defenderConfig = unit != null ? new UnitConfiguration(unit) : null;
        _result = null;
    }

    private void OnDefenderConfigChanged(UnitConfiguration config)
    {
        _defenderConfig = config;
        _result = null;
    }

    // --- Combat ---
    private void OnChargeStateChanged(ChargeState state)
    {
        _chargeState = state;
        _result = null;
    }

    private void OnIterationsChanged(int iterations)
    {
        _iterations = iterations;
        _result = null;
    }

    private async Task RunSimulation()
    {
        if (_attackerConfig == null || _defenderConfig == null) return;

        _isSimulating = true;
        _result = null;
        StateHasChanged();

        var context = new CombatContext
        {
            Charge = _chargeState,
            CombatRound = 1,
            AttackerFactionKey = _attackerFactionKey,
            DefenderFactionKey = _defenderFactionKey
        };

        _result = await Task.Run(() =>
            CombatEngine.Simulate(_attackerConfig, _defenderConfig, context, _iterations));

        _isSimulating = false;
        StateHasChanged();
    }
}
