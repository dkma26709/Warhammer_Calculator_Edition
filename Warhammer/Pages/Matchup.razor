@page "/matchup"
@inherits MatchupBase

<h3>Combat Matchup Simulator</h3>

<div class="matchup-grid">
    <!-- Row 1: Selectors + Controls -->
    <div class="mg-cell mg-sel-a">
        <div class="mg-card-header">ATTACKER</div>
        <UnitSelector Label="Attacker" OnUnitSelected="OnAttackerSelected" />
    </div>

    <div class="mg-cell mg-ctrl">
        <div class="mg-card-header">BATTLE</div>
        <div class="mb-2">
            <label class="form-label form-label-sm mb-0">Simulations</label>
            <select class="form-select form-select-sm" @bind="_simulationCount">
                <option value="1000">1,000</option>
                <option value="5000">5,000</option>
                <option value="10000">10,000</option>
                <option value="50000">50,000</option>
            </select>
        </div>
        <div class="mb-1">
            <div class="form-check form-check-sm">
                <input class="form-check-input" type="checkbox" @bind="_attackerCharged" />
                <label class="form-check-label small">Atk charged</label>
            </div>
        </div>
        <div class="mb-2">
            <div class="form-check form-check-sm">
                <input class="form-check-input" type="checkbox" @bind="_defenderCharged" />
                <label class="form-check-label small">Def charged</label>
            </div>
        </div>
        <button class="btn btn-danger w-100"
                @onclick="RunSimulation"
                disabled="@(!CanSimulate)">
            FIGHT!
        </button>
        @if (_isSimulating)
        {
            <div class="text-center mt-1">
                <div class="spinner-border spinner-border-sm text-danger" role="status">
                    <span class="visually-hidden">Simulating...</span>
                </div>
            </div>
        }
    </div>

    <div class="mg-cell mg-sel-b">
        <div class="mg-card-header">DEFENDER</div>
        <UnitSelector Label="Defender" OnUnitSelected="OnDefenderSelected" />
    </div>

    <!-- Row 2: Configs + Results -->
    <div class="mg-cell mg-cfg-a">
        @if (_attackerUnit is not null)
        {
            <UnitConfigurator Unit="_attackerUnit" FactionName="@_attackerFaction"
                              OnConfigurationChanged="OnAttackerConfigChanged"
                              OpponentConfig="@_defenderConfig" />
        }
    </div>

    <div class="mg-cell mg-results">
        @if (_summary is not null)
        {
            <CombatResultsPanel Summary="_summary"
                                UnitAName="@AttackerName"
                                UnitBName="@DefenderName" />
        }
        else
        {
            <div class="text-center text-muted small py-3">
                Select units and click FIGHT
            </div>
        }
    </div>

    <div class="mg-cell mg-cfg-b">
        @if (_defenderUnit is not null)
        {
            <UnitConfigurator Unit="_defenderUnit" FactionName="@_defenderFaction"
                              OnConfigurationChanged="OnDefenderConfigChanged"
                              OpponentConfig="@_attackerConfig" />
        }
    </div>

    <!-- Row 3: Charts -->
    <div class="mg-cell mg-chart1">
        @if (_summary is not null)
        {
            <CombatDistributionChart Distribution="_summary.WoundsAToBDistribution"
                                     Title="@($"Wounds: {AttackerName} → {DefenderName}")"
                                     SeriesName="% chance" />
        }
    </div>

    <div class="mg-cell mg-chart2">
        @if (_summary is not null)
        {
            <CombatDistributionChart Distribution="_summary.CombatResDiffDistribution"
                                     Title="@($"Combat Res Diff (+ve = {AttackerName})")"
                                     SeriesName="% chance" />
        }
    </div>

    <div class="mg-cell mg-chart3">
        @if (_summary is not null)
        {
            <CombatDistributionChart Distribution="_summary.WoundsBToADistribution"
                                     Title="@($"Wounds: {DefenderName} → {AttackerName}")"
                                     SeriesName="% chance" />
        }
    </div>
</div>
