@page "/builder"

@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@using Warhammer.Models.Domain
@using Warhammer.Models.Enums
@using Warhammer.Models.Json
@using Warhammer.Services

@inject IGameDataRepository Repo
@inject ArmyListValidator Validator
@inject ArmyListSerializer Serializer
@inject PortraitService Portraits
@inject GameSystemService SystemService
@inject IJSRuntime JS

<div class="container-fluid py-3">

    @* ─── Header: faction + points target ─────────────────────────── *@
    <div class="row g-3 mb-3">
        <div class="col-md-4">
            <label class="form-label small text-body-secondary">Faction</label>
            <select class="form-select form-select-sm" value="@_factionKey"
                    @onchange="OnFactionChanged">
                <option value="">-- Select Faction --</option>
                @foreach (var f in Repo.AllFactions)
                {
                    <option value="@f.ToJsonKey()">@f.ToDisplayName()</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label small text-body-secondary">Points</label>
            <input type="text" class="form-control form-control-sm"
                   inputmode="numeric" pattern="[0-9]*"
                   value="@_pointsText"
                   @oninput="OnPointsInput" />
        </div>
        <div class="col">
            <label class="form-label small text-body-secondary">Name</label>
            <input type="text" class="form-control form-control-sm"
                   value="@_armyList.Name" @onchange="OnNameChanged" />
        </div>
        <div class="col-auto d-flex align-items-end gap-1">
            <button type="button" class="btn btn-sm btn-outline-light"
                    disabled="@(_factionKey == null)"
                    @onclick="ExportList">Export</button>
            <label class="btn btn-sm btn-outline-light mb-0">
                Import
                <InputFile OnChange="OnImportFileSelected" accept=".json" style="display:none;" />
            </label>
            <button type="button" class="btn btn-sm btn-outline-secondary"
                    @onclick="NewList">New</button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_statusMessage))
    {
        <div class="alert @(_statusIsError ? "alert-danger" : "alert-info") py-1 px-2 small" role="alert">
            @_statusMessage
        </div>
    }

    @if (_factionKey == null)
    {
        <div class="alert alert-secondary">Select a faction to begin.</div>
    }
    else if (_factionUnits == null)
    {
        <div class="alert alert-secondary">Loading…</div>
    }
    else
    {
        @* ─── Top: Army overview (total + per-category bars) ──────── *@
        <div class="card bg-dark text-light border-secondary mb-3">
            <div class="card-body p-2">
                @{
                    var total = _armyList.TotalPoints;
                    var target = _armyList.PointsTarget;
                    var totalPct = target > 0 ? Math.Min(100.0, total / target * 100.0) : 0;
                    var totalOver = total > target;
                    var totalClass = totalOver ? "bg-danger" : (total == target ? "bg-success" : "bg-info");
                }
                <div class="d-flex justify-content-between align-items-baseline mb-1">
                    <strong>@_armyList.Name</strong>
                    <span class="@(totalOver ? "text-danger" : "")">
                        <strong>@total.ToString("F0")</strong>
                        <span class="text-body-secondary"> / @target pts</span>
                    </span>
                </div>
                <div class="progress mb-2" style="height: 8px; background-color: #333;">
                    <div class="progress-bar @totalClass" role="progressbar" style="width: @totalPct.ToString("F0")%"></div>
                </div>

                <div class="row g-2">
                    @foreach (var (cat, used, cap, isMin) in CategoryBars)
                    {
                        var pct = cap > 0 ? Math.Min(100.0, used / cap * 100.0) : 0;
                        var over = isMin ? used < cap : used > cap;
                        var barClass = over ? "bg-danger" : "bg-success";
                        <div class="col-6 col-md-4 col-xl-2">
                            <div class="d-flex justify-content-between" style="font-size: 0.75rem;">
                                <span>@cat @(isMin ? "(min)" : "")</span>
                                <span>@used.ToString("F0")/@cap.ToString("F0")</span>
                            </div>
                            <div class="progress" style="height: 5px; background-color: #333;">
                                <div class="progress-bar @barClass" role="progressbar" style="width: @pct.ToString("F0")%"></div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="row g-3">

            @* ─── Left: Unit browser ────────────────────────────── *@
            <div class="col-lg-4">
                <div class="card bg-dark text-light border-secondary">
                    <div class="card-header py-2">
                        <strong>Add units</strong>
                    </div>
                    <div class="card-body p-2" style="max-height: 70vh; overflow-y: auto;">
                        @foreach (var cat in BrowseCategories)
                        {
                            var units = UnitsInCategory(cat);
                            if (units.Count == 0) continue;

                            <div class="mb-2">
                                <div class="small text-body-secondary fw-bold mb-1">@cat.ToJsonKey()</div>
                                @foreach (var unit in units)
                                {
                                    <button type="button"
                                            class="btn btn-sm btn-outline-light w-100 text-start d-flex align-items-center gap-2 mb-1"
                                            @onclick="() => AddUnit(unit)">
                                        <UnitPortrait Unit="unit" Height="32" ShowBorder="false" />
                                        <span class="flex-grow-1">@unit.Name</span>
                                        <span class="text-body-secondary">@unit.BaseModelCost pts</span>
                                    </button>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>

            @* ─── Right: Active list ─────────────────────────────── *@
            <div class="col-lg-8">
                <div class="card bg-dark text-light border-secondary">
                    <div class="card-header py-2 d-flex justify-content-between">
                        <strong>Army List</strong>
                        <span class="text-body-secondary">
                            @_armyList.TotalPoints.ToString("F0") / @_armyList.PointsTarget pts
                        </span>
                    </div>
                    <div class="card-body p-2">
                        @if (_armyList.Units.Count == 0)
                        {
                            <div class="text-center text-body-secondary py-4">
                                <em>No units — pick from the left to start building.</em>
                            </div>
                        }
                        else
                        {
                            @foreach (var cat in BrowseCategories)
                            {
                                var entries = _armyList.Units
                                    .Where(u => u.ResolvedUnit.Category == cat)
                                    .ToList();
                                if (entries.Count == 0) continue;

                                <div class="mb-3">
                                    <div class="small text-body-secondary fw-bold mb-1">@cat.ToJsonKey()</div>
                                    @foreach (var entry in entries)
                                    {
                                        <div class="border border-secondary rounded mb-2" @key="entry">
                                            <div class="d-flex align-items-center p-2 gap-2">
                                                <UnitPortrait Unit="entry.ResolvedUnit" Height="56" />
                                                <div class="flex-grow-1">
                                                    @if (!string.IsNullOrWhiteSpace(entry.Loadout.CustomName))
                                                    {
                                                        <div>
                                                            <strong>@entry.Loadout.CustomName</strong>
                                                            <span class="text-body-secondary"> · @entry.ResolvedUnit.Name</span>
                                                            @if (entry.Loadout.IsGeneral) { <span class="badge bg-warning text-dark ms-1">General</span> }
                                                            @if (entry.Loadout.IsBattleStandardBearer) { <span class="badge bg-info text-dark ms-1">BSB</span> }
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <div>
                                                            @entry.ResolvedUnit.Name
                                                            @if (entry.Loadout.IsGeneral) { <span class="badge bg-warning text-dark ms-1">General</span> }
                                                            @if (entry.Loadout.IsBattleStandardBearer) { <span class="badge bg-info text-dark ms-1">BSB</span> }
                                                        </div>
                                                    }
                                                    <small class="text-body-secondary">
                                                        @entry.ModelCount model@(entry.ModelCount == 1 ? "" : "s") ·
                                                        @entry.TotalPointsCost.ToString("F0") pts
                                                    </small>
                                                </div>
                                                @if (cat.IsCharacterCategory())
                                                {
                                                    <button class="btn btn-sm me-1 @(entry.Loadout.IsGeneral ? "btn-warning" : "btn-outline-warning")"
                                                            title="Designate General"
                                                            @onclick="() => ToggleGeneral(entry)">General</button>
                                                }
                                                @if (entry.IsBattleStandardEligible)
                                                {
                                                    <button class="btn btn-sm me-1 @(entry.Loadout.IsBattleStandardBearer ? "btn-info" : "btn-outline-info")"
                                                            title="Battle Standard Bearer"
                                                            @onclick="() => ToggleBsb(entry)">BSB</button>
                                                }
                                                @if (entry.CanHaveChampion && entry.CanHaveMusician && entry.CanHaveStandardBearer)
                                                {
                                                    <button class="btn btn-sm me-1 @(HasFullCommand(entry) ? "btn-success" : "btn-outline-success")"
                                                            title="Full Command (Champion + Musician + Standard)"
                                                            @onclick="() => ToggleFullCommand(entry)">F/C</button>
                                                }
                                                <button class="btn btn-sm btn-outline-secondary me-1"
                                                        title="Edit"
                                                        @onclick="() => ToggleExpand(entry)">
                                                    @(_expanded.Contains(entry) ? "Collapse" : "Edit")
                                                </button>
                                                <button class="btn btn-sm btn-outline-secondary me-1"
                                                        title="Duplicate"
                                                        @onclick="() => DuplicateUnit(entry)">
                                                    Duplicate
                                                </button>
                                                <button class="btn btn-sm btn-outline-danger"
                                                        title="Remove"
                                                        @onclick="() => RemoveUnit(entry)">
                                                    ✕
                                                </button>
                                            </div>

                                            @if (_expanded.Contains(entry))
                                            {
                                                <div class="border-top border-secondary p-2">
                                                    <UnitConfigurator @key="@($"cfg-{entry.GetHashCode()}")"
                                                                      Unit="entry.ResolvedUnit"
                                                                      Configuration="entry"
                                                                      ConfigurationChanged="OnEntryChanged"
                                                                      FactionExtras="_factionExtras"
                                                                      CommonMagicItems="_commonMagicItems"
                                                                      ShowCustomNameField="true" />
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>

        @* ─── Bottom: Validation ────────────────────────────────── *@
        <div class="row g-3 mt-2">
            <div class="col-12">
                <div class="card bg-dark text-light border-secondary">
                    <div class="card-header py-2"><strong>Validation</strong></div>
                    <div class="card-body p-2">
                        @if (_issues.Count == 0)
                        {
                            <div class="text-success small">✓ List is valid.</div>
                        }
                        else
                        {
                            @foreach (var issue in _issues)
                            {
                                var colour = issue.Severity == ValidationSeverity.Error ? "text-danger" : "text-warning";
                                <div class="small @colour">@issue.Message</div>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private static readonly UnitCategory[] BrowseCategories =
        [UnitCategory.Lords, UnitCategory.Heroes, UnitCategory.Characters, UnitCategory.Core, UnitCategory.Special, UnitCategory.Rare];

    private string? _factionKey;
    private string _pointsText = "2000";
    private IReadOnlyList<Unit>? _factionUnits;
    private FactionExtrasData? _factionExtras;
    private IReadOnlyList<MagicItemEntry>? _commonMagicItems;

    private ArmyList _armyList = new()
    {
        Faction = FactionKeyExtensions.All.First(),
        PointsTarget = 2000,
    };

    private List<ValidationIssue> _issues = [];
    private readonly HashSet<UnitConfiguration> _expanded = new();

    private string? _statusMessage;
    private bool _statusIsError;
    private const string LegacyStorageKey = "warhammer.armylist.active";
    private string StorageKey => $"warhammer.armylist.active.{SystemService.CurrentSystem}";

    protected override async Task OnInitializedAsync()
    {
        await Repo.EnsureLoadedAsync();
        await Portraits.EnsureLoadedAsync();
        _commonMagicItems = await Repo.GetCommonMagicItemsAsync();
        await TryLoadFromStorage();
    }

    private async Task TryLoadFromStorage()
    {
        string? saved;
        bool fromLegacyKey = false;
        try
        {
            saved = await JS.InvokeAsync<string?>("armyBuilder.loadLocal", StorageKey);

            // Autosaves from before multi-system support live under the unsuffixed key.
            if (string.IsNullOrWhiteSpace(saved) && SystemService.CurrentSystem == GameSystems.Default)
            {
                saved = await JS.InvokeAsync<string?>("armyBuilder.loadLocal", LegacyStorageKey);
                fromLegacyKey = !string.IsNullOrWhiteSpace(saved);
            }
        }
        catch { return; }

        if (string.IsNullOrWhiteSpace(saved)) return;

        var result = await Serializer.DeserializeAsync(saved);
        if (result.Success && result.List != null)
        {
            _armyList = result.List;
            _factionKey = result.List.Faction.ToJsonKey();
            _pointsText = result.List.PointsTarget.ToString();
            _factionUnits = await Repo.GetUnitsAsync(result.List.Faction);
            _factionExtras = await Repo.GetFactionExtrasAsync(result.List.Faction);
            Revalidate();

            if (fromLegacyKey)
            {
                try
                {
                    await JS.InvokeVoidAsync("armyBuilder.saveLocal", StorageKey, saved);
                    await JS.InvokeVoidAsync("armyBuilder.clearLocal", LegacyStorageKey);
                }
                catch { }
            }
        }
    }

    // ─── Faction + points + name ──────────────────────────────────

    private async Task OnFactionChanged(ChangeEventArgs e)
    {
        var key = e.Value?.ToString();
        _factionKey = string.IsNullOrEmpty(key) ? null : key;
        _factionUnits = null;
        _factionExtras = null;
        _expanded.Clear();

        if (_factionKey != null && FactionKeyExtensions.TryFromJsonKey(_factionKey, out var fk))
        {
            _armyList = _armyList with { Faction = fk, Units = new() };
            _factionUnits = await Repo.GetUnitsAsync(fk);
            _factionExtras = await Repo.GetFactionExtrasAsync(fk);
        }

        Revalidate();
    }

    private async Task OnPointsInput(ChangeEventArgs e)
    {
        var raw = e.Value?.ToString() ?? "";
        var digits = new string(raw.Where(char.IsDigit).ToArray());

        if (digits != raw)
        {
            // Sync Blazor's notion of the value with the DOM first, so the
            // rewrite to the sanitized string always produces a DOM update.
            _pointsText = raw;
            StateHasChanged();
            await Task.Yield();
        }

        _pointsText = digits;
        if (int.TryParse(digits, out var n) && n > 0)
        {
            _armyList = _armyList with { PointsTarget = n };
            Revalidate();
        }
    }

    private void OnNameChanged(ChangeEventArgs e)
    {
        _armyList = _armyList with { Name = e.Value?.ToString() ?? "Untitled List" };
    }

    // ─── Unit operations ──────────────────────────────────────────

    private IReadOnlyList<Unit> UnitsInCategory(UnitCategory cat) =>
        _factionUnits?.Where(u => u.Category == cat).OrderBy(u => u.Name).ToList()
        ?? [];

    private void AddUnit(Unit unit)
    {
        var cfg = new UnitConfiguration(unit);
        _armyList.Units.Add(cfg);
        Revalidate();
    }

    private void RemoveUnit(UnitConfiguration entry)
    {
        _armyList.Units.Remove(entry);
        _expanded.Remove(entry);
        Revalidate();
    }

    private void DuplicateUnit(UnitConfiguration src)
    {
        var clone = new UnitConfiguration(src.ResolvedUnit)
        {
            ModelCount = src.ModelCount,
            Frontage = src.Frontage,
            HasChampion = src.HasChampion,
            HasMusician = src.HasMusician,
            HasStandardBearer = src.HasStandardBearer,
            SelectedWeapon = src.SelectedWeapon,
            Loadout =
            {
                WizardLevel = src.Loadout.WizardLevel,
                SelectedLore = src.Loadout.SelectedLore,
                SelectedBanner = src.Loadout.SelectedBanner,
                // Duplicate does NOT copy IsGeneral / IsBattleStandardBearer — single-instance flags.
                // CustomName is also not copied — a named character should not share its identity with its clone.
            },
        };
        foreach (var (k, v) in src.SelectedUpgrades) clone.SelectedUpgrades[k] = v;
        foreach (var (cat, picks) in src.Loadout.SelectedFactionUpgrades)
            clone.Loadout.SelectedFactionUpgrades[cat] = new List<SelectedFactionUpgrade>(picks);
        clone.SelectedMagicItems.AddRange(src.SelectedMagicItems);
        clone.Modifiers.AddRange(src.Modifiers);
        clone.Loadout.SelectedSpells.AddRange(src.Loadout.SelectedSpells);

        var idx = _armyList.Units.IndexOf(src);
        _armyList.Units.Insert(idx + 1, clone);
        Revalidate();
    }

    private void ToggleExpand(UnitConfiguration entry)
    {
        if (!_expanded.Remove(entry)) _expanded.Add(entry);
    }

    private void ToggleGeneral(UnitConfiguration entry)
    {
        if (entry.Loadout.IsGeneral)
        {
            entry.Loadout.IsGeneral = false;
        }
        else
        {
            foreach (var u in _armyList.Units) u.Loadout.IsGeneral = false;
            entry.Loadout.IsGeneral = true;
        }
        Revalidate();
    }

    private void ToggleBsb(UnitConfiguration entry)
    {
        if (entry.Loadout.IsBattleStandardBearer)
        {
            entry.Loadout.IsBattleStandardBearer = false;
        }
        else
        {
            foreach (var u in _armyList.Units) u.Loadout.IsBattleStandardBearer = false;
            entry.Loadout.IsBattleStandardBearer = true;
        }
        Revalidate();
    }

    private static bool HasFullCommand(UnitConfiguration entry) =>
        entry.HasChampion && entry.HasMusician && entry.HasStandardBearer;

    private void ToggleFullCommand(UnitConfiguration entry)
    {
        var enable = !HasFullCommand(entry);
        entry.HasChampion = enable;
        entry.HasMusician = enable;
        entry.HasStandardBearer = enable;
        if (!enable) entry.Loadout.SelectedBanner = null;
        Revalidate();
    }

    private void OnEntryChanged(UnitConfiguration _)
    {
        // UnitConfigurator mutates the same instance — just revalidate.
        Revalidate();
    }

    // ─── Validation + summary ─────────────────────────────────────

    private void Revalidate()
    {
        _issues = Validator.Validate(_armyList);
        _ = AutosaveAsync();
    }

    private async Task AutosaveAsync()
    {
        if (_factionKey == null) return;
        try
        {
            var json = Serializer.Serialize(_armyList);
            await JS.InvokeVoidAsync("armyBuilder.saveLocal", StorageKey, json);
        }
        catch
        {
            // Storage unavailable (private mode, quota) — non-fatal.
        }
    }

    // ─── Export / Import / New ────────────────────────────────────

    private async Task ExportList()
    {
        var json = Serializer.Serialize(_armyList);
        var safeName = string.Concat((_armyList.Name ?? "army-list").Split(Path.GetInvalidFileNameChars()));
        var filename = $"{safeName}.json";
        await JS.InvokeVoidAsync("armyBuilder.downloadJson", filename, json);
        SetStatus($"Exported '{filename}'.", isError: false);
    }

    private async Task OnImportFileSelected(InputFileChangeEventArgs e)
    {
        try
        {
            await using var stream = e.File.OpenReadStream(maxAllowedSize: 2 * 1024 * 1024);
            using var reader = new StreamReader(stream);
            var json = await reader.ReadToEndAsync();
            var result = await Serializer.DeserializeAsync(json);

            if (!result.Success)
            {
                SetStatus("Import failed: " + string.Join("; ", result.Errors), isError: true);
                return;
            }

            _armyList = result.List!;
            _factionKey = _armyList.Faction.ToJsonKey();
            _pointsText = _armyList.PointsTarget.ToString();
            _factionUnits = await Repo.GetUnitsAsync(_armyList.Faction);
            _factionExtras = await Repo.GetFactionExtrasAsync(_armyList.Faction);
            _expanded.Clear();

            var msg = $"Imported {_armyList.Units.Count} units.";
            if (result.Warnings.Count > 0) msg += " Warnings: " + string.Join("; ", result.Warnings);
            SetStatus(msg, isError: false);
            Revalidate();
        }
        catch (Exception ex)
        {
            SetStatus($"Import error: {ex.Message}", isError: true);
        }
    }

    private async Task NewList()
    {
        _armyList = new ArmyList
        {
            Faction = _armyList.Faction,
            PointsTarget = _armyList.PointsTarget,
        };
        _expanded.Clear();
        Revalidate();
        try { await JS.InvokeVoidAsync("armyBuilder.clearLocal", StorageKey); } catch { }
        SetStatus("New list started.", isError: false);
    }

    private void SetStatus(string message, bool isError)
    {
        _statusMessage = message;
        _statusIsError = isError;
    }

    private IEnumerable<(string Label, double Used, double Cap, bool IsMin)> CategoryBars
    {
        get
        {
            double target = _armyList.PointsTarget;
            // v2 books split characters into Lords/Heroes with their own caps; v3 books
            // have a single Characters section governed only by the combined cap.
            bool splitCharacters = _factionUnits?.Any(u => u.Category is UnitCategory.Lords or UnitCategory.Heroes) ?? true;
            if (splitCharacters)
            {
                yield return ("Lords", _armyList.PointsInCategory(UnitCategory.Lords),
                    target * ArmyCompositionRules.LordsMaxPercent, false);
                yield return ("Heroes", _armyList.PointsInCategory(UnitCategory.Heroes),
                    target * ArmyCompositionRules.HeroesMaxPercent, false);
            }
            yield return (splitCharacters ? "Characters (combined)" : "Characters",
                _armyList.PointsInCategory(UnitCategory.Lords)
                    + _armyList.PointsInCategory(UnitCategory.Heroes)
                    + _armyList.PointsInCategory(UnitCategory.Characters),
                target * ArmyCompositionRules.CharactersCombinedMaxPercent, false);
            yield return ("Core", _armyList.PointsInCategory(UnitCategory.Core),
                target * ArmyCompositionRules.CoreMinPercent, true);
            yield return ("Special", _armyList.PointsInCategory(UnitCategory.Special),
                target * ArmyCompositionRules.SpecialMaxPercent, false);
            yield return ("Rare", _armyList.PointsInCategory(UnitCategory.Rare),
                target * ArmyCompositionRules.RareMaxPercent, false);
        }
    }
}
