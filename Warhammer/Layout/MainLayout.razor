@inherits LayoutComponentBase
@using Microsoft.JSInterop
@using Warhammer.Models.Domain
@using Warhammer.Services
@inject GameSystemService SystemService
@inject IJSRuntime JS
@inject NavigationManager Navigation

<nav class="navbar navbar-expand navbar-dark wr-header px-3 no-print">
    <span class="navbar-brand mb-0 wr-brand">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"
             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="14.5 17.5 3 6 3 3 6 3 17.5 14.5"></polyline><line x1="13" y1="19" x2="19" y2="13"></line>
            <line x1="16" y1="16" x2="20" y2="20"></line><line x1="19" y1="21" x2="21" y2="19"></line>
            <polyline points="14.5 6.5 18 3 21 3 21 6 17.5 9.5"></polyline><line x1="5" y1="14" x2="9" y2="18"></line>
            <line x1="7" y1="17" x2="4" y2="20"></line><line x1="3" y1="19" x2="5" y2="21"></line>
        </svg>
        <span class="wr-brand-kicker">WAP</span>
        <span class="wr-brand-name">Combat Simulator</span>
    </span>
    <ul class="navbar-nav">
        <li class="nav-item">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">Matchup</NavLink>
        </li>
        <li class="nav-item">
            <NavLink class="nav-link" href="gauntlet">Gauntlet</NavLink>
        </li>
        <li class="nav-item">
            <NavLink class="nav-link" href="builder">Builder</NavLink>
        </li>
    </ul>
    <div class="ms-auto d-flex align-items-center">
        <label class="wr-label me-2" for="system-select">System</label>
        <select id="system-select" class="form-select form-select-sm w-auto"
                value="@SystemService.CurrentSystem" @onchange="OnSystemChanged"
                title="Select game system">
            @foreach (var system in GameSystems.All)
            {
                <option value="@system.Key" disabled="@(!system.Enabled)"
                        selected="@(system.Key == SystemService.CurrentSystem)">@system.DisplayName</option>
            }
        </select>
    </div>
</nav>

@code {
    private async Task OnSystemChanged(ChangeEventArgs e)
    {
        var key = e.Value?.ToString();
        if (key == null || key == SystemService.CurrentSystem || !GameSystems.IsEnabled(key))
            return;

        await JS.InvokeVoidAsync("localStorage.setItem", GameSystemService.StorageKey, key);
        // Full reload: every service cache and page state is rebuilt for the new system.
        Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
    }
}

@Body
