@inherits LayoutComponentBase

<nav class="navbar navbar-expand navbar-dark bg-dark border-bottom border-secondary px-3">
    <span class="navbar-brand mb-0 h6 text-light">WAP Combat Simulator</span>
    <ul class="navbar-nav">
        <li class="nav-item">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">Matchup</NavLink>
        </li>
        <li class="nav-item">
            <NavLink class="nav-link" href="gauntlet">Gauntlet</NavLink>
        </li>
        <li class="nav-item">
            <NavLink class="nav-link" href="builder">Builder</NavLink>
        </li>
    </ul>
    <div class="ms-auto d-flex align-items-center">
        <label class="text-secondary small me-2" for="system-select">System</label>
        <select id="system-select" class="form-select form-select-sm bg-dark text-light border-secondary w-auto"
                @bind="selectedSystem" title="Only WAP v2 is currently supported">
            <option value="wap-v2">WAP v2</option>
            <option value="wap-v3" disabled>WAP v3</option>
            <option value="fantasy-8th" disabled>Fantasy 8th</option>
            <option value="old-world" disabled>Old World</option>
        </select>
    </div>
</nav>

@code {
    private string selectedSystem = "wap-v2";
}

@Body
