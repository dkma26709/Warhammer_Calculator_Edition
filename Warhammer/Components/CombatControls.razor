@using Warhammer.Calculator.Models

<div class="text-center">
    <div class="mb-3">
        <label class="form-label small text-body-secondary">Charge</label>
        <select class="form-select form-select-sm" value="@((int)ChargeState)"
                @onchange="OnChargeChanged">
            <option value="0">Neither</option>
            <option value="1">Attacker charged</option>
            <option value="2">Defender charged</option>
        </select>
    </div>

    <button class="btn btn-danger btn-sm w-100"
            disabled="@(!CanSimulate || IsSimulating)"
            @onclick="OnSimulate">
        @if (IsSimulating)
        {
            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
            <span>Simulating...</span>
        }
        else
        {
            <span>Simulate Combat</span>
        }
    </button>

    <small class="text-body-secondary d-block mt-1">10,000 iterations</small>
</div>

@code {
    [Parameter] public ChargeState ChargeState { get; set; }
    [Parameter] public EventCallback<ChargeState> ChargeStateChanged { get; set; }
    [Parameter] public bool CanSimulate { get; set; }
    [Parameter] public bool IsSimulating { get; set; }
    [Parameter] public EventCallback OnSimulate { get; set; }

    private async Task OnChargeChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var val))
            await ChargeStateChanged.InvokeAsync((ChargeState)val);
    }
}
