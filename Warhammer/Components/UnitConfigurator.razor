    // ─── Custom modifiers ─────────────────────────────────────────

    private async Task AddCustomModifier()
    {
        if (Configuration == null) return;
        Configuration.Modifiers.Add(new UnitModifier { Label = "Custom", Source = "Manual" });
        await ConfigurationChanged.InvokeAsync(Configuration);
    }

    private async Task RemoveCustomModifier(int index)
    {
        if (Configuration == null || index < 0 || index >= Configuration.Modifiers.Count) return;
        Configuration.Modifiers.RemoveAt(index);
        await ConfigurationChanged.InvokeAsync(Configuration);
    }

    private async Task OnCustomModifierChanged(int index, UnitModifier modifier)
    {
        if (Configuration == null || index < 0 || index >= Configuration.Modifiers.Count) return;
        Configuration.Modifiers[index] = modifier;
        await ConfigurationChanged.InvokeAsync(Configuration);
    }

    // ─── Wizard: lore + spells ───────────────────────────────────

    private List<LoreEntry> AvailableLores =>
        FactionExtras?.LoresOfMagic ?? new List<LoreEntry>();

    private LoreEntry? SelectedLoreEntry =>
        Configuration?.SelectedLore == null
            ? null
            : AvailableLores.FirstOrDefault(l => l.Name == Configuration.SelectedLore);

    private async Task OnWizardLevelChanged(ChangeEventArgs e)
    {
        if (Configuration == null) return;
        if (int.TryParse(e.Value?.ToString(), out var lvl) && lvl is >= 1 and <= 4)
        {
            Configuration.WizardLevel = lvl;
            // Drop any spells that now exceed the new lower cap.
            while (Configuration.SelectedSpells.Count > lvl)
                Configuration.SelectedSpells.RemoveAt(Configuration.SelectedSpells.Count - 1);
        }
        await ConfigurationChanged.InvokeAsync(Configuration);
    }

    private async Task OnLoreChanged(ChangeEventArgs e)
    {
        if (Configuration == null) return;
        var name = e.Value?.ToString();
        Configuration.SelectedLore = string.IsNullOrEmpty(name) ? null : name;
        Configuration.SelectedSpells.Clear();
        await ConfigurationChanged.InvokeAsync(Configuration);
    }

    private async Task OnSpellToggled(string spellName, bool isChecked)
    {
        if (Configuration == null) return;
        if (isChecked)
        {
            if (Configuration.SelectedSpells.Count >= Configuration.WizardLevel) return;
            if (!Configuration.SelectedSpells.Contains(spellName))
                Configuration.SelectedSpells.Add(spellName);
        }
        else
        {
            Configuration.SelectedSpells.Remove(spellName);
        }
        await ConfigurationChanged.InvokeAsync(Configuration);
    }

    // ─── Magic banner ────────────────────────────────────────────

    private List<MagicItemEntry> AvailableBanners =>
        AllMagicItems.Where(m => m.Category == "magic_standard").ToList();

    private static double ParseBannerPoints(string points) =>
        double.TryParse(points, out var v) ? v : 0;

    private async Task OnBannerSelected(ChangeEventArgs e)
    {
        if (Configuration == null) return;
        var name = e.Value?.ToString();
        if (string.IsNullOrEmpty(name)) return;

        var banner = AvailableBanners.FirstOrDefault(b => b.Name == name);
        if (banner == null) return;

        var cost = ParseBannerPoints(banner.Points);
        if (Configuration.BannerBudget is int cap && cost > cap) return;

        Configuration.SelectedBanner = new SelectedMagicItem
        {
            Name = banner.Name,
            Category = banner.Category,
            PointsCost = cost,
        };
        await ConfigurationChanged.InvokeAsync(Configuration);
    }

    private async Task RemoveBanner()
    {
        if (Configuration == null) return;
        Configuration.SelectedBanner = null;
        await ConfigurationChanged.InvokeAsync(Configuration);
    }
}
