@using Warhammer.Models.Domain
@using Warhammer.Models.Enums
@using Warhammer.Models.Json
@using Warhammer.Services

@inject IGameDataRepository Repo

@if (Unit != null && Configuration != null)
{
    <StatTable Profile="Configuration.PrimaryProfile" MountProfile="Configuration.MountProfile" />

    <div class="mb-2 d-flex justify-content-between align-items-center">
        <small class="text-body-secondary">
            @Configuration.BaseModelCost pts/model
        </small>
        <span class="fw-bold">
            @Configuration.TotalPointsCost.ToString("F0") pts
        </span>
    </div>

    @if (!Configuration.TroopType.IsCharacter)
    {
        <div class="row g-2 mb-2">
            <div class="col-6">
                <label class="form-label small text-body-secondary">Models</label>
                <input type="number" class="form-control form-control-sm"
                       value="@Configuration.ModelCount" min="1" max="100"
                       @onchange="OnModelCountChangedEvent" />
            </div>
            <div class="col-6">
                <label class="form-label small text-body-secondary">Frontage</label>
                <input type="number" class="form-control form-control-sm"
                       value="@Configuration.Frontage" min="1" max="50"
                       @onchange="OnFrontageChangedEvent" />
            </div>
        </div>
    }

    @* ── Weapons ── *@
    @if (AvailableWeapons.Count > 1)
    {
        <div class="mb-2">
            <label class="form-label small text-body-secondary">Fight with</label>
            <select class="form-select form-select-sm" value="@Configuration.SelectedWeaponKey"
                    @onchange="OnWeaponChanged">
                @foreach (var (key, name, cost) in AvailableWeapons)
                {
                    <option value="@key.ToJsonKey()">@name @cost</option>
                }
            </select>
        </div>
    }

    @* ── Armour ── *@
    @foreach (var (idx, option) in _armourOptions)
    {
        @RenderOptionControl(idx, option)
    }

    @* ── Other Upgrades ── *@
    @foreach (var (idx, option) in _otherOptions)
    {
        @RenderOptionControl(idx, option)
    }

    @* ── Special rules (faction-specific) ── *@
    @if (Configuration.SpecialRules.ShadowDancesOfLoec)
    {
        <div class="mb-2">
            <label class="form-label small text-body-secondary">Shadow Dance of Loec</label>
            <select class="form-select form-select-sm" value="@Configuration.SelectedShadowDance"
                    @onchange="OnShadowDanceChanged">
                <option value="@ShadowDance.None">— None —</option>
                <option value="@ShadowDance.WhirlingDeath">Whirling Death (AP1 + KB)</option>
                <option value="@ShadowDance.StormOfBlades">Storm of Blades (+1 Attack)</option>
                <option value="@ShadowDance.TheShadowsCoil">The Shadows Coil (-1 to be Hit)</option>
                <option value="@ShadowDance.WovenMist">Woven Mist (ASF)</option>
            </select>
        </div>
    }

    @if (Configuration.SpecialRules.TreeAspects)
    {
        <div class="mb-2">
            <label class="form-label small text-body-secondary">Tree Aspect</label>
            <select class="form-select form-select-sm" value="@Configuration.SelectedTreeAspect"
                    @onchange="OnTreeAspectChanged">
                <option value="@TreeAspect.None">— None —</option>
                <option value="@TreeAspect.Birch">Birch (+1 Attack)</option>
                <option value="@TreeAspect.Oak">Oak (+1 Toughness)</option>
                <option value="@TreeAspect.Willow">Willow (-1 to be Hit)</option>
            </select>
        </div>
    }

    @if (Configuration.SpecialRules.TreeWhack)
    {
        <div class="mb-2">
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="@(_id + "-treewhack")"
                       checked="@Configuration.UseTreeWhack"
                       @onchange="e => OnTreeWhackChanged((bool)(e.Value ?? false))" />
                <label class="form-check-label small" for="@(_id + "-treewhack")">
                    Tree Whack (single attack: Init test or D6 Wounds, no armour)
                </label>
            </div>
        </div>
    }

    @* ── Command Group ── *@
    @if (Configuration.CanHaveChampion || Configuration.CanHaveMusician || Configuration.CanHaveStandardBearer)
    {
        <div class="mb-2">
            <label class="form-label small text-body-secondary">Command Group</label>
            <div class="d-flex gap-3">
                @if (Configuration.CanHaveChampion)
                {
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="checkbox" id="@(_id + "-champ")"
                               checked="@Configuration.HasChampion"
                               @onchange="e => OnChampionChanged((bool)(e.Value ?? false))" />
                        <label class="form-check-label small" for="@(_id + "-champ")">Champion</label>
                    </div>
                }
                @if (Configuration.CanHaveMusician)
                {
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="checkbox" id="@(_id + "-mus")"
                               checked="@Configuration.HasMusician"
                               @onchange="e => OnMusicianChanged((bool)(e.Value ?? false))" />
                        <label class="form-check-label small" for="@(_id + "-mus")">Musician</label>
                    </div>
                }
                @if (Configuration.CanHaveStandardBearer)
                {
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="checkbox" id="@(_id + "-std")"
                               checked="@Configuration.HasStandardBearer"
                               @onchange="e => OnStandardChanged((bool)(e.Value ?? false))" />
                        <label class="form-check-label small" for="@(_id + "-std")">Standard</label>
                    </div>
                }
            </div>
        </div>
    }

    @* ── Wizard: lore + spells ── *@
    @if (Configuration.IsWizardCapable && AvailableLores.Count > 0)
    {
        <div class="mb-3 border border-secondary rounded p-2">
            <label class="form-label small text-body-secondary">Wizard</label>
            <div class="row g-2">
                <div class="col-4">
                    <label class="form-label small text-body-secondary mb-0">Level</label>
                    <select class="form-select form-select-sm" value="@Configuration.WizardLevel"
                            @onchange="OnWizardLevelChanged">
                        @for (int lvl = 1; lvl <= 4; lvl++)
                        {
                            <option value="@lvl">@lvl</option>
                        }
                    </select>
                </div>
                <div class="col-8">
                    <label class="form-label small text-body-secondary mb-0">Lore</label>
                    <select class="form-select form-select-sm" value="@(Configuration.SelectedLore ?? "")"
                            @onchange="OnLoreChanged">
                        <option value="">— Select lore —</option>
                        @foreach (var lore in AvailableLores)
                        {
                            <option value="@lore.Name">@lore.Name</option>
                        }
                    </select>
                </div>
            </div>

            @if (SelectedLoreEntry != null)
            {
                var spellsPicked = Configuration.SelectedSpells.Count;
                var atLimit = spellsPicked >= Configuration.WizardLevel;
                <div class="mt-2">
                    <label class="form-label small text-body-secondary mb-1">
                        Spells (@spellsPicked / @Configuration.WizardLevel)
                    </label>
                    @foreach (var spell in SelectedLoreEntry.Spells)
                    {
                        var checkedNow = Configuration.SelectedSpells.Contains(spell.Name);
                        var disabled = !checkedNow && atLimit;
                        <div class="form-check small">
                            <input class="form-check-input" type="checkbox"
                                   id="@(_id + "-spell-" + spell.Name.GetHashCode())"
                                   checked="@checkedNow"
                                   disabled="@disabled"
                                   @onchange="e => OnSpellToggled(spell.Name, (bool)(e.Value ?? false))" />
                            <label class="form-check-label" for="@(_id + "-spell-" + spell.Name.GetHashCode())">
                                @spell.Name
                                @if (spell.Level > 0) { <span class="text-body-secondary"> (L@(spell.Level))</span> }
                                @if (spell.CastValue > 0) { <span class="text-body-secondary"> cast @(spell.CastValue)+</span> }
                            </label>
                        </div>
                    }
                </div>
            }
        </div>
    }

    @* ── Magic Banner ── *@
    @if (Configuration.HasStandardBearer && Configuration.BannerBudget is int bannerCap && AvailableBanners.Count > 0)
    {
        <div class="mb-3 border border-secondary rounded p-2">
            <label class="form-label small text-body-secondary">
                Magic Standard (@(Configuration.SelectedBanner?.PointsCost ?? 0) / @bannerCap pts)
            </label>
            @if (Configuration.SelectedBanner != null)
            {
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="small"><strong>@Configuration.SelectedBanner.Name</strong>
                        <span class="text-body-secondary">(@Configuration.SelectedBanner.PointsCost pts)</span>
                    </span>
                    <button class="btn btn-outline-danger btn-sm py-0 px-1" style="font-size:0.7rem"
                            @onclick="RemoveBanner">✕</button>
                </div>
            }
            else
            {
                <select class="form-select form-select-sm" value="" @onchange="OnBannerSelected">
                    <option value="">— Add magic standard —</option>
                    @foreach (var banner in AvailableBanners)
                    {
                        var cost = ParseBannerPoints(banner.Points);
                        var disabled = cost > bannerCap;
                        <option value="@banner.Name" disabled="@disabled">
                            @banner.Name (@banner.Points pts)
                        </option>
                    }
                </select>
            }
        </div>
    }

    @* ── Magic Items ── *@
    @if (Configuration.ResolvedUnit.MagicItemAllowance.HasValue && AllMagicItems.Count > 0)
    {
        <MagicItemSelector MagicItems="AllMagicItems"
                           Configuration="Configuration"
                           ConfigurationChanged="ConfigurationChanged" />
    }

    @* ── Custom Modifiers ── *@
    <div class="mb-2">
        @if (Configuration.Modifiers.Count > 0)
        {
            <label class="form-label small text-body-secondary">Custom Modifiers</label>
            @for (int mi = 0; mi < Configuration.Modifiers.Count; mi++)
            {
                var capturedIndex = mi;
                <div class="position-relative">
                    <button class="btn btn-outline-danger btn-sm py-0 px-1 position-absolute top-0 end-0" style="font-size:0.7rem; z-index:1"
                            @onclick="() => RemoveCustomModifier(capturedIndex)">✕</button>
                    <ModifierEditor Value="@Configuration.Modifiers[capturedIndex]"
                                    ValueChanged="m => OnCustomModifierChanged(capturedIndex, m)" />
                </div>
            }
        }
        <button class="btn btn-outline-secondary btn-sm" @onclick="AddCustomModifier">
            + Custom modifier
        </button>
    </div>

    @if (Unit.RawEntry.Equipment != null)
    {
        <div class="mb-2">
            <small class="text-body-secondary">Equipment: @(Unit.RawEntry.Equipment.Split('\n')[0])</small>
        </div>
    }

    <SpecialRuleBadges Rules="Configuration.EffectiveSpecialRules" />
}

@code {
    [Parameter] public Unit? Unit { get; set; }
    [Parameter] public UnitConfiguration? Configuration { get; set; }
    [Parameter] public EventCallback<UnitConfiguration> ConfigurationChanged { get; set; }
    [Parameter] public FactionExtrasData? FactionExtras { get; set; }
    [Parameter] public IReadOnlyList<MagicItemEntry>? CommonMagicItems { get; set; }

    private List<MagicItemEntry> AllMagicItems =>
        [.. CommonMagicItems ?? [], .. FactionExtras?.MagicItems ?? []];

    private string _id = Guid.NewGuid().ToString("N")[..8];

    private List<(int Index, UnitOption Option)> _armourOptions = [];
    private List<(int Index, UnitOption Option)> _otherOptions = [];

    protected override void OnParametersSet()
    {
        ClassifyOptions();
    }

    // ─── Option classification ───────────────────────────────────

    private enum OptionSection { Weapon, Armour, Other, Skip }

    private record ClassifiedChoice(string DisplayName, bool IsWeapon, bool IsCloseCombatWeapon, bool IsArmour);

    private void ClassifyOptions()
    {
        _armourOptions = [];
        _otherOptions = [];

        if (Unit?.Options == null) return;

        for (int i = 0; i < Unit.Options.Count; i++)
        {
            var option = Unit.Options[i];
            var section = GetOptionSection(option);

            switch (section)
            {
                case OptionSection.Armour:
                    _armourOptions.Add((i, option));
                    break;
                case OptionSection.Other:
                    _otherOptions.Add((i, option));
                    break;
            }
        }
    }

    private OptionSection GetOptionSection(UnitOption option)
    {
        switch (option.Type)
        {
            case "equipment":
                if (option.Choices == null || option.Choices.Count == 0) return OptionSection.Skip;
                var classified = ClassifyChoices(option);
                if (classified.Count == 0) return OptionSection.Skip;
                if (classified.All(c => c.IsCloseCombatWeapon)) return OptionSection.Weapon;
                if (classified.All(c => c.IsArmour)) return OptionSection.Armour;
                return OptionSection.Other;

            case "mount":
            case "upgrade":
            case "wizard_upgrade":
            case "blessed_spawning":
                return OptionSection.Other;

            default:
                return OptionSection.Skip;
        }
    }

    private List<ClassifiedChoice> ClassifyChoices(UnitOption option)
    {
        var result = new List<ClassifiedChoice>();
        if (option.Choices == null) return result;

        foreach (var choice in option.Choices)
        {
            bool anyWeapon = false, anyCCWeapon = false, anyArmour = false;
            foreach (var name in choice.Name)
            {
                if (EquipmentParser.TryNormalize(name, out var key, out bool isWeapon))
                {
                    if (isWeapon)
                    {
                        anyWeapon = true;
                        if (CloseCombatWeaponKeyExtensions.TryFromJsonKey(key, out _))
                            anyCCWeapon = true;
                    }
                    else
                    {
                        anyArmour = true;
                    }
                }
            }

            result.Add(new ClassifiedChoice(choice.DisplayName, anyWeapon, anyCCWeapon, anyArmour));
        }

        return result;
    }

    // ─── Unified option rendering ────────────────────────────────

    private RenderFragment RenderOptionControl(int idx, UnitOption option) => builder =>
    {
        switch (option.Type)
        {
            case "equipment":
                RenderEquipmentOption(builder, idx, option);
                break;
            case "mount":
                RenderChoicesDropdown(builder, idx, option, "Mount");
                break;
            case "upgrade" when option.SubOptions != null:
                RenderSubOptionsDropdown(builder, idx, option);
                break;
            case "blessed_spawning" when HasFactionUpgradeCategory(option):
                RenderFactionUpgradeMultiSelect(builder, option);
                break;
            case "upgrade" or "wizard_upgrade" or "blessed_spawning":
                RenderFlatCheckbox(builder, idx, option);
                break;
        }
    };

    private bool HasFactionUpgradeCategory(UnitOption option)
    {
        var category = UnitConfiguration.FactionUpgradeCategoryFor(option.Type);
        if (category is null || FactionExtras?.FactionUpgrades is null) return false;
        return FactionExtras.FactionUpgrades.TryGetValue(category, out var entries) && entries.Count > 0;
    }

    private void RenderFactionUpgradeMultiSelect(
        Microsoft.AspNetCore.Components.Rendering.RenderTreeBuilder builder,
        UnitOption option)
    {
        if (Configuration is null || FactionExtras?.FactionUpgrades is null) return;
        var category = UnitConfiguration.FactionUpgradeCategoryFor(option.Type);
        if (category is null) return;
        if (!FactionExtras.FactionUpgrades.TryGetValue(category, out var entries)) return;

        var selected = Configuration.SelectedFactionUpgrades.TryGetValue(category, out var list)
            ? list
            : (Configuration.SelectedFactionUpgrades[category] = new List<string>());

        var label = FormatUpgradeCategory(category);
        var perPick = option.Points ?? 0;
        var costSuffix = option.PerModel == true
            ? $"+{perPick:F0} pt/model each"
            : $"+{perPick:F0} pts each";

        builder.OpenElement(0, "div");
        builder.AddAttribute(1, "class", "mb-3 border border-secondary rounded p-2");

        builder.OpenElement(2, "label");
        builder.AddAttribute(3, "class", "form-label small text-body-secondary");
        builder.AddContent(4, $"{label} ({costSuffix})");
        builder.CloseElement();

        int seq = 10;
        foreach (var entry in entries)
        {
            var checkedNow = selected.Contains(entry.Name);
            var inputId = _id + "-fup-" + entry.Name.GetHashCode();

            builder.OpenElement(seq++, "div");
            builder.AddAttribute(seq++, "class", "form-check small");

            builder.OpenElement(seq++, "input");
            builder.AddAttribute(seq++, "class", "form-check-input");
            builder.AddAttribute(seq++, "type", "checkbox");
            builder.AddAttribute(seq++, "id", inputId);
            builder.AddAttribute(seq++, "checked", checkedNow);
            builder.AddAttribute(seq++, "onchange",
                Microsoft.AspNetCore.Components.EventCallback.Factory.Create<ChangeEventArgs>(
                    this, async e => await OnFactionUpgradeToggled(category, entry.Name, (bool)(e.Value ?? false))));
            builder.CloseElement();

            builder.OpenElement(seq++, "label");
            builder.AddAttribute(seq++, "class", "form-check-label");
            builder.AddAttribute(seq++, "for", inputId);
            builder.AddContent(seq++, entry.Name);
            if (!string.IsNullOrEmpty(entry.Points) && entry.Points.Any(char.IsDigit))
            {
                builder.AddContent(seq++, $" ({entry.Points} pts)");
            }
            builder.CloseElement();

            builder.CloseElement();
        }
        builder.CloseElement();
    }

    private async Task OnFactionUpgradeToggled(string category, string name, bool isChecked)
    {
        if (Configuration is null) return;
        if (!Configuration.SelectedFactionUpgrades.TryGetValue(category, out var list))
        {
            list = new List<string>();
            Configuration.SelectedFactionUpgrades[category] = list;
        }

        if (isChecked && !list.Contains(name)) list.Add(name);
        else if (!isChecked) list.Remove(name);

        await ConfigurationChanged.InvokeAsync(Configuration);
    }

    private static string FormatUpgradeCategory(string category) => category switch
    {
        "blessed_spawnings" => "Blessed Spawnings",
        _ => category.Replace('_', ' '),
    };

    private void RenderEquipmentOption(Microsoft.AspNetCore.Components.Rendering.RenderTreeBuilder builder, int idx, UnitOption option)
    {
        if (option.Choices == null) return;
        var classified = ClassifyChoices(option);

        if (option.Choices.Count == 1)
        {
            // Single choice → checkbox
            var choice = option.Choices[0];
            var info = classified[0];
            var isSelected = Configuration!.SelectedUpgrades.TryGetValue(idx, out var selIdx) && selIdx == 0;
            var costLabel = FormatCost(choice);
            var capturedIdx = idx;

            builder.OpenElement(0, "div");
            builder.AddAttribute(1, "class", "mb-2");
            builder.OpenElement(2, "div");
            builder.AddAttribute(3, "class", "form-check");
            builder.OpenElement(4, "input");
            builder.AddAttribute(5, "class", "form-check-input");
            builder.AddAttribute(6, "type", "checkbox");
            builder.AddAttribute(7, "id", $"{_id}-opt-{capturedIdx}");
            builder.AddAttribute(8, "checked", isSelected);
            builder.AddAttribute(9, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(this,
                e => OnUpgradeToggled(capturedIdx, (bool)(e.Value ?? false))));
            builder.CloseElement();
            builder.OpenElement(10, "label");
            builder.AddAttribute(11, "class", "form-check-label small");
            builder.AddAttribute(12, "for", $"{_id}-opt-{capturedIdx}");
            builder.AddContent(13, $"{info.DisplayName} {costLabel}");
            builder.CloseElement();
            builder.CloseElement();
            builder.CloseElement();
        }
        else
        {
            // Multiple choices → dropdown
            var currentChoice = Configuration!.SelectedUpgrades.TryGetValue(idx, out var curIdx) ? curIdx : -1;
            var label = option.Action == "replace" && option.Replaces != null
                ? $"Replace {option.Replaces}"
                : classified.Any(c => c.IsArmour) ? "Armour" : "Equipment";
            var capturedIdx = idx;

            builder.OpenElement(0, "div");
            builder.AddAttribute(1, "class", "mb-2");
            builder.OpenElement(2, "label");
            builder.AddAttribute(3, "class", "form-label small text-body-secondary");
            builder.AddContent(4, label);
            builder.CloseElement();
            builder.OpenElement(5, "select");
            builder.AddAttribute(6, "class", "form-select form-select-sm");
            builder.AddAttribute(7, "value", currentChoice);
            builder.AddAttribute(8, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(this,
                e => OnUpgradeSelected(capturedIdx, int.TryParse(e.Value?.ToString(), out var v) ? v : -1)));
            builder.OpenElement(9, "option");
            builder.AddAttribute(10, "value", -1);
            builder.AddContent(11, "— None —");
            builder.CloseElement();
            for (int ci = 0; ci < option.Choices.Count; ci++)
            {
                var choice = option.Choices[ci];
                var info = classified[ci];
                builder.OpenElement(12, "option");
                builder.AddAttribute(13, "value", ci);
                builder.AddContent(14, $"{info.DisplayName} {FormatCost(choice)}");
                builder.CloseElement();
            }
            builder.CloseElement();
            builder.CloseElement();
        }
    }

    private void RenderChoicesDropdown(Microsoft.AspNetCore.Components.Rendering.RenderTreeBuilder builder, int idx, UnitOption option, string label)
    {
        if (option.Choices == null || option.Choices.Count == 0) return;
        var currentChoice = Configuration!.SelectedUpgrades.TryGetValue(idx, out var curIdx) ? curIdx : -1;
        var capturedIdx = idx;

        builder.OpenElement(0, "div");
        builder.AddAttribute(1, "class", "mb-2");
        builder.OpenElement(2, "label");
        builder.AddAttribute(3, "class", "form-label small text-body-secondary");
        builder.AddContent(4, label);
        builder.CloseElement();
        builder.OpenElement(5, "select");
        builder.AddAttribute(6, "class", "form-select form-select-sm");
        builder.AddAttribute(7, "value", currentChoice);
        builder.AddAttribute(8, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(this,
            e => OnUpgradeSelected(capturedIdx, int.TryParse(e.Value?.ToString(), out var v) ? v : -1)));
        builder.OpenElement(9, "option");
        builder.AddAttribute(10, "value", -1);
        builder.AddContent(11, "— None —");
        builder.CloseElement();
        for (int ci = 0; ci < option.Choices.Count; ci++)
        {
            var choice = option.Choices[ci];
            builder.OpenElement(12, "option");
            builder.AddAttribute(13, "value", ci);
            builder.AddContent(14, $"{choice.DisplayName} {FormatCost(choice)}");
            builder.CloseElement();
        }
        builder.CloseElement();
        builder.CloseElement();
    }

    private void RenderSubOptionsDropdown(Microsoft.AspNetCore.Components.Rendering.RenderTreeBuilder builder, int idx, UnitOption option)
    {
        if (option.SubOptions == null || option.SubOptions.Count == 0) return;
        var currentChoice = Configuration!.SelectedUpgrades.TryGetValue(idx, out var curIdx) ? curIdx : -1;
        var capturedIdx = idx;
        var label = option.Upgrade ?? "Upgrade";

        builder.OpenElement(0, "div");
        builder.AddAttribute(1, "class", "mb-2");
        builder.OpenElement(2, "label");
        builder.AddAttribute(3, "class", "form-label small text-body-secondary");
        builder.AddContent(4, label);
        builder.CloseElement();
        builder.OpenElement(5, "select");
        builder.AddAttribute(6, "class", "form-select form-select-sm");
        builder.AddAttribute(7, "value", currentChoice);
        builder.AddAttribute(8, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(this,
            e => OnUpgradeSelected(capturedIdx, int.TryParse(e.Value?.ToString(), out var v) ? v : -1)));
        builder.OpenElement(9, "option");
        builder.AddAttribute(10, "value", -1);
        builder.AddContent(11, "— None —");
        builder.CloseElement();
        for (int si = 0; si < option.SubOptions.Count; si++)
        {
            var sub = option.SubOptions[si];
            var name = sub.Choices?.FirstOrDefault()?.DisplayName ?? sub.Upgrade ?? "Option";
            var pts = sub.Choices?.FirstOrDefault()?.Points ?? sub.Points ?? 0;
            var perModel = sub.Choices?.FirstOrDefault()?.PerModel ?? sub.PerModel ?? false;
            var costLabel = FormatFlatCost(pts, perModel);
            builder.OpenElement(12, "option");
            builder.AddAttribute(13, "value", si);
            builder.AddContent(14, $"{name} {costLabel}");
            builder.CloseElement();
        }
        builder.CloseElement();
        builder.CloseElement();
    }

    private void RenderFlatCheckbox(Microsoft.AspNetCore.Components.Rendering.RenderTreeBuilder builder, int idx, UnitOption option)
    {
        var isSelected = Configuration!.SelectedUpgrades.TryGetValue(idx, out var selIdx) && selIdx == 0;
        var name = option.Upgrade ?? option.Type;
        var costLabel = FormatFlatCost(option.Points ?? 0, option.PerModel ?? false);
        var capturedIdx = idx;

        builder.OpenElement(0, "div");
        builder.AddAttribute(1, "class", "mb-2");
        builder.OpenElement(2, "div");
        builder.AddAttribute(3, "class", "form-check");
        builder.OpenElement(4, "input");
        builder.AddAttribute(5, "class", "form-check-input");
        builder.AddAttribute(6, "type", "checkbox");
        builder.AddAttribute(7, "id", $"{_id}-opt-{capturedIdx}");
        builder.AddAttribute(8, "checked", isSelected);
        builder.AddAttribute(9, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(this,
            e => OnUpgradeToggled(capturedIdx, (bool)(e.Value ?? false))));
        builder.CloseElement();
        builder.OpenElement(10, "label");
        builder.AddAttribute(11, "class", "form-check-label small");
        builder.AddAttribute(12, "for", $"{_id}-opt-{capturedIdx}");
        builder.AddContent(13, $"{name} {costLabel}");
        builder.CloseElement();
        builder.CloseElement();
        builder.CloseElement();
    }

    // ─── Formatting helpers ──────────────────────────────────────

    private static string FormatCost(OptionChoice choice)
    {
        var cost = choice.Points ?? 0;
        if (cost == 0) return "(free)";
        var pts = cost % 1 == 0 ? cost.ToString("F0") : cost.ToString("G");
        return choice.PerModel ? $"(+{pts} pts/model)" : $"(+{pts} pts)";
    }

    private static string FormatFlatCost(double points, bool perModel)
    {
        if (points == 0) return "(free)";
        var pts = points % 1 == 0 ? points.ToString("F0") : points.ToString("G");
        return perModel ? $"(+{pts} pts/model)" : $"(+{pts} pts)";
    }

    // ─── Available weapons (for weapon dropdown) ─────────────────

    private List<(CloseCombatWeaponKey Key, string Name, string Cost)> AvailableWeapons
    {
        get
        {
            if (Configuration == null) return [];
            var weapons = new List<(CloseCombatWeaponKey Key, string Name, string Cost)>();
            var seen = new HashSet<CloseCombatWeaponKey>();

            foreach (var key in Configuration.BaseWeaponKeys)
            {
                if (!seen.Add(key)) continue;
                var w = Repo.GetWeapon(key);
                if (w != null) weapons.Add((key, w.Name, ""));
            }

            if (Unit?.Options != null)
            {
                foreach (var option in Unit.Options)
                {
                    if (option.Type != "equipment" || option.Choices == null) continue;
                    foreach (var choice in option.Choices)
                    {
                        foreach (var name in choice.Name)
                        {
                            if (EquipmentParser.TryNormalize(name, out var normalized, out bool isWeapon)
                                && isWeapon
                                && CloseCombatWeaponKeyExtensions.TryFromJsonKey(normalized, out var enumKey)
                                && seen.Add(enumKey))
                            {
                                var w = Repo.GetWeapon(enumKey);
                                if (w != null) weapons.Add((enumKey, w.Name, FormatCost(choice)));
                            }
                        }
                    }
                }
            }

            if (weapons.Count == 0)
                weapons.Add((CloseCombatWeaponKey.HandWeapon, "HAND WEAPON", ""));

            return weapons;
        }
    }

    // ─── Event handlers ──────────────────────────────────────────

    private async Task OnModelCountChangedEvent(ChangeEventArgs e)
    {
        if (Configuration == null) return;
        var count = int.TryParse(e.Value?.ToString(), out var v) ? v : 1;
        Configuration.ModelCount = Math.Max(1, count);
        await ConfigurationChanged.InvokeAsync(Configuration);
    }

    private async Task OnFrontageChangedEvent(ChangeEventArgs e)
    {
        if (Configuration == null) return;
        var frontage = int.TryParse(e.Value?.ToString(), out var v) ? v : 5;
        Configuration.Frontage = Math.Max(1, frontage);
        await ConfigurationChanged.InvokeAsync(Configuration);
    }

    private async Task OnWeaponChanged(ChangeEventArgs e)
    {
        if (Configuration == null || Unit?.Options == null) return;
        var weaponKey = e.Value?.ToString() ?? "handWeapon";
        Configuration.SelectedWeaponKey = weaponKey;

        for (int i = 0; i < Unit.Options.Count; i++)
        {
            var option = Unit.Options[i];
            if (option.Type != "equipment" || option.Choices == null) continue;

            bool groupHasCCWeapons = option.Choices.Any(c =>
                c.Name.Any(n => EquipmentParser.TryNormalize(n, out var k, out bool isW)
                    && isW && CloseCombatWeaponKeyExtensions.TryFromJsonKey(k, out _)));
            if (!groupHasCCWeapons) continue;

            int matchIdx = -1;
            for (int ci = 0; ci < option.Choices.Count; ci++)
            {
                foreach (var name in option.Choices[ci].Name)
                {
                    if (EquipmentParser.TryNormalize(name, out var k, out _) && k == weaponKey)
                    {
                        matchIdx = ci;
                        break;
                    }
                }

                if (matchIdx >= 0) break;
            }

            if (matchIdx >= 0)
                Configuration.SelectedUpgrades[i] = matchIdx;
            else
                Configuration.SelectedUpgrades.Remove(i);
        }

        await ConfigurationChanged.InvokeAsync(Configuration);
    }

    private async Task OnUpgradeToggled(int optionIndex, bool selected)
    {
        if (Configuration == null) return;
        if (selected)
            Configuration.SelectedUpgrades[optionIndex] = 0;
        else
            Configuration.SelectedUpgrades.Remove(optionIndex);
        await ConfigurationChanged.InvokeAsync(Configuration);
    }

    private async Task OnUpgradeSelected(int optionIndex, int choiceIndex)
    {
        if (Configuration == null) return;
        if (choiceIndex < 0)
            Configuration.SelectedUpgrades.Remove(optionIndex);
        else
            Configuration.SelectedUpgrades[optionIndex] = choiceIndex;
        await ConfigurationChanged.InvokeAsync(Configuration);
    }

