@using Warhammer.Models.Json
@using Warhammer.Models.Domain
@using Warhammer.Services

@if (Unit != null && Configuration != null)
{
    <StatTable Profile="Configuration.PrimaryProfile" MountProfile="Configuration.MountProfile" />

    <div class="mb-2 d-flex justify-content-between align-items-center">
        <small class="text-body-secondary">
            @Configuration.BaseModelCost pts/model
        </small>
        <span class="fw-bold">
            @Configuration.TotalPointsCost.ToString("F0") pts
        </span>
    </div>

    @if (!Configuration.TroopType.IsCharacter)
    {
        <div class="row g-2 mb-2">
            <div class="col-6">
                <label class="form-label small text-body-secondary">Models</label>
                <input type="number" class="form-control form-control-sm"
                       value="@Configuration.ModelCount" min="1" max="100"
                       @onchange="OnModelCountChangedEvent" />
            </div>
            <div class="col-6">
                <label class="form-label small text-body-secondary">Frontage</label>
                <input type="number" class="form-control form-control-sm"
                       value="@Configuration.Frontage" min="1" max="50"
                       @onchange="OnFrontageChangedEvent" />
            </div>
        </div>
    }

    @* Close combat weapon selection — from effective weapons *@
    @if (AvailableWeapons.Count > 1)
    {
        <div class="mb-2">
            <label class="form-label small text-body-secondary">Weapon</label>
            <select class="form-select form-select-sm" value="@Configuration.SelectedWeaponKey"
                    @onchange="OnWeaponChanged">
                @foreach (var (key, name) in AvailableWeapons)
                {
                    <option value="@key">@name</option>
                }
            </select>
        </div>
    }

    @* Equipment upgrade options (weapons, armour, shields) *@
    @if (Unit.Options != null)
    {
        @for (int idx = 0; idx < Unit.Options.Count; idx++)
        {
            var option = Unit.Options[idx];
            if (option.Type != "equipment" || option.Choices == null || option.Choices.Count == 0) continue;

            // Classify what this option group contains
            var classified = ClassifyChoices(option);
            if (classified.Count == 0) continue;

            // Skip pure close-combat weapon groups — they're handled by the weapon dropdown
            if (classified.All(c => c.IsCloseCombatWeapon)) continue;

            var capturedIdx = idx;

            @if (option.Action == "add" && option.Choices.Count == 1)
            {
                // Single add option → checkbox
                var choice = option.Choices[0];
                var info = classified[0];
                var isSelected = Configuration.SelectedUpgrades.TryGetValue(capturedIdx, out var selIdx) && selIdx == 0;
                var costLabel = FormatCost(choice);

                <div class="mb-2">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="@(_id + "-opt-" + capturedIdx)"
                               checked="@isSelected"
                               @onchange="e => OnUpgradeToggled(capturedIdx, (bool)(e.Value ?? false))" />
                        <label class="form-check-label small" for="@(_id + "-opt-" + capturedIdx)">
                            @info.DisplayName @costLabel
                        </label>
                    </div>
                </div>
            }
            else
            {
                // Choose or replace → dropdown
                var currentChoice = Configuration.SelectedUpgrades.TryGetValue(capturedIdx, out var curIdx) ? curIdx : -1;
                var label = option.Action == "replace" && option.Replaces != null
                    ? $"Replace {option.Replaces}"
                    : classified.Any(c => !c.IsCloseCombatWeapon && c.IsWeapon) ? "Ranged Weapon" : "Armour";

                <div class="mb-2">
                    <label class="form-label small text-body-secondary">@label</label>
                    <select class="form-select form-select-sm" value="@currentChoice"
                            @onchange="e => OnUpgradeSelected(capturedIdx, int.TryParse(e.Value?.ToString(), out var v) ? v : -1)">
                        <option value="-1">— None —</option>
                        @for (int ci = 0; ci < option.Choices.Count; ci++)
                        {
                            var choice = option.Choices[ci];
                            var info = classified[ci];
                            <option value="@ci">@info.DisplayName @FormatCost(choice)</option>
                        }
                    </select>
                </div>
            }
        }
    }

    @if (Configuration.SpecialRules.ShadowDancesOfLoec)
    {
        <div class="mb-2">
            <label class="form-label small text-body-secondary">Shadow Dance of Loec</label>
            <select class="form-select form-select-sm" value="@Configuration.SelectedShadowDance"
                    @onchange="OnShadowDanceChanged">
                <option value="@ShadowDance.None">— None —</option>
                <option value="@ShadowDance.WhirlingDeath">Whirling Death (AP1 + KB)</option>
                <option value="@ShadowDance.StormOfBlades">Storm of Blades (+1 Attack)</option>
                <option value="@ShadowDance.TheShadowsCoil">The Shadows Coil (-1 to be Hit)</option>
                <option value="@ShadowDance.WovenMist">Woven Mist (ASF)</option>
            </select>
        </div>
    }

    @if (Configuration.SpecialRules.TreeAspects)
    {
        <div class="mb-2">
            <label class="form-label small text-body-secondary">Tree Aspect</label>
            <select class="form-select form-select-sm" value="@Configuration.SelectedTreeAspect"
                    @onchange="OnTreeAspectChanged">
                <option value="@TreeAspect.None">— None —</option>
                <option value="@TreeAspect.Birch">Birch (+1 Attack)</option>
                <option value="@TreeAspect.Oak">Oak (+1 Toughness)</option>
                <option value="@TreeAspect.Willow">Willow (-1 to be Hit)</option>
            </select>
        </div>
    }

    @if (Configuration.SpecialRules.TreeWhack)
    {
        <div class="mb-2">
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="@(_id + "-treewhack")"
                       checked="@Configuration.UseTreeWhack"
                       @onchange="e => OnTreeWhackChanged((bool)(e.Value ?? false))" />
                <label class="form-check-label small" for="@(_id + "-treewhack")">
                    Tree Whack (single attack: Init test or D6 Wounds, no armour)
                </label>
            </div>
        </div>
    }

    @if (Configuration.CanHaveChampion || Configuration.CanHaveMusician || Configuration.CanHaveStandardBearer)
    {
        <div class="mb-2">
            <label class="form-label small text-body-secondary">Command Group</label>
            <div class="d-flex gap-3">
                @if (Configuration.CanHaveChampion)
                {
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="checkbox" id="@(_id + "-champ")"
                               checked="@Configuration.HasChampion"
                               @onchange="e => OnChampionChanged((bool)(e.Value ?? false))" />
                        <label class="form-check-label small" for="@(_id + "-champ")">Champion</label>
                    </div>
                }
                @if (Configuration.CanHaveMusician)
                {
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="checkbox" id="@(_id + "-mus")"
                               checked="@Configuration.HasMusician"
                               @onchange="e => OnMusicianChanged((bool)(e.Value ?? false))" />
                        <label class="form-check-label small" for="@(_id + "-mus")">Musician</label>
                    </div>
                }
                @if (Configuration.CanHaveStandardBearer)
                {
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="checkbox" id="@(_id + "-std")"
                               checked="@Configuration.HasStandardBearer"
                               @onchange="e => OnStandardChanged((bool)(e.Value ?? false))" />
                        <label class="form-check-label small" for="@(_id + "-std")">Standard</label>
                    </div>
                }
            </div>
        </div>
    }

    @if (Unit.Equipment != null)
    {
        <div class="mb-2">
            <small class="text-body-secondary">Equipment: @(Unit.Equipment.Split('\n')[0])</small>
        </div>
    }

    <SpecialRuleBadges Rules="Configuration.SpecialRules" />
}

@code {
    [Parameter] public UnitEntry? Unit { get; set; }
    [Parameter] public UnitConfiguration? Configuration { get; set; }
    [Parameter] public EventCallback<UnitConfiguration> ConfigurationChanged { get; set; }
    [Parameter] public CoreRulesService? CoreRules { get; set; }

    private string _id = Guid.NewGuid().ToString("N")[..8];

    private record ClassifiedChoice(string DisplayName, bool IsWeapon, bool IsCloseCombatWeapon, bool IsArmour);

    private List<ClassifiedChoice> ClassifyChoices(UnitOption option)
    {
        var result = new List<ClassifiedChoice>();
        if (option.Choices == null) return result;

        foreach (var choice in option.Choices)
        {
            bool anyWeapon = false, anyCCWeapon = false, anyArmour = false;
            foreach (var name in choice.Name)
            {
                if (EquipmentParser.TryNormalize(name, out var key, out bool isWeapon))
                {
                    if (isWeapon)
                    {
                        anyWeapon = true;
                        if (EquipmentParser.IsCloseCombatWeaponKey(key))
                            anyCCWeapon = true;
                    }
                    else
                    {
                        anyArmour = true;
                    }
                }
            }

            result.Add(new ClassifiedChoice(choice.DisplayName, anyWeapon, anyCCWeapon, anyArmour));
        }

        return result;
    }

    private static string FormatCost(OptionChoice choice)
    {
        var cost = choice.Points ?? 0;
        if (cost == 0) return "(free)";
        var pts = cost % 1 == 0 ? cost.ToString("F0") : cost.ToString("G");
        return choice.PerModel ? $"(+{pts} pts/model)" : $"(+{pts} pts)";
    }

    private List<(string Key, string Name)> AvailableWeapons
    {
        get
        {
            if (Configuration == null || CoreRules == null) return [];
            var weapons = new List<(string Key, string Name)>();
            var seen = new HashSet<string>();

            // Base equipment close combat weapons
            foreach (var key in Configuration.BaseWeaponKeys)
            {
                if (!EquipmentParser.IsCloseCombatWeaponKey(key) || !seen.Add(key)) continue;
                var w = CoreRules.GetCloseCombatWeapon(key);
                if (w != null) weapons.Add((key, w.Name));
            }

            // Close combat weapons from equipment options (all choices, not just selected)
            if (Unit?.Options != null)
            {
                foreach (var option in Unit.Options)
                {
                    if (option.Type != "equipment" || option.Choices == null) continue;
                    foreach (var choice in option.Choices)
                    {
                        foreach (var name in choice.Name)
                        {
                            if (EquipmentParser.TryNormalize(name, out var key, out bool isWeapon)
                                && isWeapon && EquipmentParser.IsCloseCombatWeaponKey(key) && seen.Add(key))
                            {
                                var w = CoreRules.GetCloseCombatWeapon(key);
                                if (w != null) weapons.Add((key, w.Name));
                            }
                        }
                    }
                }
            }

            if (weapons.Count == 0)
                weapons.Add(("handWeapon", "HAND WEAPON"));

            return weapons;
        }
    }

    private async Task OnModelCountChangedEvent(ChangeEventArgs e)
    {
        if (Configuration == null) return;
        var count = int.TryParse(e.Value?.ToString(), out var v) ? v : 1;
        Configuration.ModelCount = Math.Max(1, count);
        await ConfigurationChanged.InvokeAsync(Configuration);
    }

    private async Task OnFrontageChangedEvent(ChangeEventArgs e)
    {
        if (Configuration == null) return;
        var frontage = int.TryParse(e.Value?.ToString(), out var v) ? v : 5;
        Configuration.Frontage = Math.Max(1, frontage);
        await ConfigurationChanged.InvokeAsync(Configuration);
    }

    private async Task OnWeaponChanged(ChangeEventArgs e)
    {
        if (Configuration == null || Unit?.Options == null) return;
        var weaponKey = e.Value?.ToString() ?? "handWeapon";
        Configuration.SelectedWeaponKey = weaponKey;

        // Sync SelectedUpgrades: find the equipment option group containing this weapon
        // and select the matching choice (or deselect if it's a base weapon)
        for (int i = 0; i < Unit.Options.Count; i++)
        {
            var option = Unit.Options[i];
            if (option.Type != "equipment" || option.Choices == null) continue;

            // Check if any choice in this group is a CC weapon
            bool groupHasCCWeapons = option.Choices.Any(c =>
                c.Name.Any(n => EquipmentParser.TryNormalize(n, out var k, out bool isW)
                    && isW && EquipmentParser.IsCloseCombatWeaponKey(k)));
            if (!groupHasCCWeapons) continue;

            // Find matching choice index
            int matchIdx = -1;
            for (int ci = 0; ci < option.Choices.Count; ci++)
            {
                foreach (var name in option.Choices[ci].Name)
                {
                    if (EquipmentParser.TryNormalize(name, out var k, out _) && k == weaponKey)
                    {
                        matchIdx = ci;
                        break;
                    }
                }

                if (matchIdx >= 0) break;
            }

            if (matchIdx >= 0)
                Configuration.SelectedUpgrades[i] = matchIdx;
            else
                Configuration.SelectedUpgrades.Remove(i);
        }

        await ConfigurationChanged.InvokeAsync(Configuration);
    }

    private async Task OnUpgradeToggled(int optionIndex, bool selected)
    {
        if (Configuration == null) return;
        if (selected)
            Configuration.SelectedUpgrades[optionIndex] = 0;
        else
            Configuration.SelectedUpgrades.Remove(optionIndex);
        await ConfigurationChanged.InvokeAsync(Configuration);
    }

    private async Task OnUpgradeSelected(int optionIndex, int choiceIndex)
    {
        if (Configuration == null) return;
        if (choiceIndex < 0)
            Configuration.SelectedUpgrades.Remove(optionIndex);
        else
            Configuration.SelectedUpgrades[optionIndex] = choiceIndex;
        await ConfigurationChanged.InvokeAsync(Configuration);
    }

    private async Task OnChampionChanged(bool value)
    {
        if (Configuration == null) return;
        Configuration.HasChampion = value;
        await ConfigurationChanged.InvokeAsync(Configuration);
    }

    private async Task OnMusicianChanged(bool value)
    {
        if (Configuration == null) return;
        Configuration.HasMusician = value;
        await ConfigurationChanged.InvokeAsync(Configuration);
    }

    private async Task OnStandardChanged(bool value)
    {
        if (Configuration == null) return;
        Configuration.HasStandardBearer = value;
        await ConfigurationChanged.InvokeAsync(Configuration);
    }

    private async Task OnShadowDanceChanged(ChangeEventArgs e)
    {
        if (Configuration == null) return;
        if (Enum.TryParse<ShadowDance>(e.Value?.ToString(), out var dance))
            Configuration.SelectedShadowDance = dance;
        await ConfigurationChanged.InvokeAsync(Configuration);
    }

    private async Task OnTreeAspectChanged(ChangeEventArgs e)
    {
        if (Configuration == null) return;
        if (Enum.TryParse<TreeAspect>(e.Value?.ToString(), out var aspect))
            Configuration.SelectedTreeAspect = aspect;
        await ConfigurationChanged.InvokeAsync(Configuration);
    }

    private async Task OnTreeWhackChanged(bool value)
    {
        if (Configuration == null) return;
        Configuration.UseTreeWhack = value;
        await ConfigurationChanged.InvokeAsync(Configuration);
    }
}
