@inject FactionDataService FactionDataService

<div class="mb-3">
    <label class="form-label fw-bold">Faction</label>
    <select class="form-select" value="@_selectedFactionId" @onchange="OnFactionChanged">
        <option value="">-- Select Faction --</option>
        @if (_factions is not null)
        {
            @foreach (var faction in _factions)
            {
                <option value="@faction.Id">@faction.Name</option>
            }
        }
    </select>
</div>

@if (_loading)
{
    <div class="text-muted small"><span class="spinner-border spinner-border-sm"></span> Loading faction data...</div>
}
else if (_factionData is not null)
{
    <div class="mb-2">
        <div class="btn-group btn-group-sm flex-wrap" role="group">
            @foreach (var cat in _categories)
            {
                <button type="button"
                        class="btn @(cat == _categoryFilter ? "btn-primary" : "btn-outline-primary")"
                        @onclick="() => SetCategoryFilter(cat)">
                    @cat
                </button>
            }
        </div>
    </div>

    <div class="mb-3">
        <label class="form-label fw-bold">Unit</label>
        <select class="form-select" value="@_selectedUnitIndex" @onchange="OnUnitChanged">
            <option value="-1">-- Select Unit --</option>
            @foreach (var (unit, idx) in FilteredUnits().Select((u, i) => (u, i)))
            {
                <option value="@idx">@unit.Name (@unit.Category, @(unit.PointsCost ?? 0)pts)</option>
            }
        </select>
    </div>
}

@code {
    [Parameter] public string Label { get; set; } = "Unit";
    [Parameter] public EventCallback<(ExtractedUnit unit, string factionName)> OnUnitSelected { get; set; }

    private List<FactionIndex>? _factions;
    private string _selectedFactionId = "";
    private ExtractedFactionData? _factionData;
    private string _categoryFilter = "All";
    private int _selectedUnitIndex = -1;
    private bool _loading;

    private static readonly string[] _categories = ["All", "Core", "Special", "Rare", "Lords", "Heroes", "Named Characters"];

    protected override async Task OnInitializedAsync()
    {
        _factions = await FactionDataService.GetFactionsAsync();
    }

    private async Task OnFactionChanged(ChangeEventArgs e)
    {
        _selectedFactionId = e.Value?.ToString() ?? "";
        _selectedUnitIndex = -1;
        _factionData = null;

        if (!string.IsNullOrEmpty(_selectedFactionId))
        {
            _loading = true;
            StateHasChanged();
            _factionData = await FactionDataService.GetFactionDataAsync(_selectedFactionId);
            _loading = false;
        }
    }

    private void SetCategoryFilter(string cat)
    {
        _categoryFilter = cat;
        _selectedUnitIndex = -1;
    }

    private List<ExtractedUnit> FilteredUnits()
    {
        if (_factionData is null) return new();
        var units = _factionData.Units;
        if (_categoryFilter != "All")
            units = units.Where(u => u.Category == _categoryFilter).ToList();
        return units;
    }

    private async Task OnUnitChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var idx) && idx >= 0)
        {
            _selectedUnitIndex = idx;
            var filtered = FilteredUnits();
            if (idx < filtered.Count)
            {
                var unit = filtered[idx];
                await OnUnitSelected.InvokeAsync((unit, _factionData?.FactionName ?? ""));
            }
        }
    }
}
