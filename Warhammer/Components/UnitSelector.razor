@using Warhammer.Models.Json
@using Warhammer.Services

<div class="mb-3">
    <label class="form-label small text-body-secondary">Faction</label>
    <select class="form-select form-select-sm" value="@SelectedFactionKey"
            @onchange="OnFactionChanged">
        <option value="">-- Select Faction --</option>
        @foreach (var key in FactionDataService.FactionNames)
        {
            <option value="@key">@FactionDataService.GetDisplayName(key)</option>
        }
    </select>
</div>

@if (FactionUnits != null)
{
    <div class="mb-2">
        <label class="form-label small text-body-secondary">Category</label>
        <select class="form-select form-select-sm" value="@_categoryFilter"
                @onchange="OnCategoryChanged">
            <option value="">All</option>
            @foreach (var cat in Categories)
            {
                <option value="@cat">@cat</option>
            }
        </select>
    </div>

    <div class="mb-3">
        <label class="form-label small text-body-secondary">Unit</label>
        <select class="form-select form-select-sm" value="@_selectedIndex"
                @onchange="OnUnitChanged">
            <option value="-1">-- Select Unit --</option>
            @foreach (var (unit, idx) in FilteredUnitsWithIndex)
            {
                <option value="@idx">@GetDisplayName(unit)</option>
            }
        </select>
    </div>
}

@code {
    [Parameter] public string? SelectedFactionKey { get; set; }
    [Parameter] public EventCallback<string> OnFactionSelected { get; set; }
    [Parameter] public FactionData? FactionUnits { get; set; }
    [Parameter] public string? SelectedUnitName { get; set; }
    [Parameter] public EventCallback<UnitEntry?> OnUnitSelected { get; set; }

    private string? _categoryFilter;
    private int _selectedIndex = -1;

    private IEnumerable<string> Categories =>
        FactionUnits?.Units.Select(u => u.Category).Distinct().OrderBy(c => c)
        ?? Enumerable.Empty<string>();

    private IEnumerable<(UnitEntry Unit, int Index)> FilteredUnitsWithIndex
    {
        get
        {
            if (FactionUnits == null) return [];
            return FactionUnits.Units
                .Select((u, i) => (Unit: u, Index: i))
                .Where(x => _categoryFilter == null || x.Unit.Category == _categoryFilter)
                .OrderBy(x => x.Unit.Category)
                .ThenBy(x => x.Unit.Name);
        }
    }

    private HashSet<string>? _duplicateNames;

    private HashSet<string> DuplicateNames
    {
        get
        {
            if (_duplicateNames != null) return _duplicateNames;
            if (FactionUnits == null) return _duplicateNames = [];
            _duplicateNames = FactionUnits.Units
                .GroupBy(u => u.Name)
                .Where(g => g.Count() > 1)
                .Select(g => g.Key)
                .ToHashSet();
            return _duplicateNames;
        }
    }

    private string GetDisplayName(UnitEntry unit)
    {
        if (!DuplicateNames.Contains(unit.Name))
            return unit.Name;

        // Disambiguate with equipment summary and points
        var parts = new List<string>();
        if (!string.IsNullOrEmpty(unit.Equipment))
        {
            var firstEquip = unit.Equipment.Split('\n')[0];
            if (firstEquip.Length > 30) firstEquip = firstEquip[..30] + "...";
            parts.Add(firstEquip);
        }
        if (unit.PointsCost.HasValue)
            parts.Add($"{unit.PointsCost}pts");
        if (!string.IsNullOrEmpty(unit.TroopType) && unit.TroopType.StartsWith("Cavalry"))
            parts.Add("Cavalry");

        return parts.Count > 0 ? $"{unit.Name} ({string.Join(", ", parts)})" : unit.Name;
    }

    private FactionData? _previousFactionUnits;

    protected override void OnParametersSet()
    {
        if (FactionUnits != _previousFactionUnits)
        {
            _previousFactionUnits = FactionUnits;
            _categoryFilter = null;
            _selectedIndex = -1;
            _duplicateNames = null;
        }
        else if (SelectedUnitName == null && _selectedIndex >= 0)
        {
            _selectedIndex = -1;
        }
    }

    private async Task OnFactionChanged(ChangeEventArgs e)
    {
        var value = e.Value?.ToString();
        await OnFactionSelected.InvokeAsync(value ?? "");
    }

    private async Task OnCategoryChanged(ChangeEventArgs e)
    {
        var value = e.Value?.ToString();
        _categoryFilter = string.IsNullOrEmpty(value) ? null : value;
    }

    private async Task OnUnitChanged(ChangeEventArgs e)
    {
        var indexStr = e.Value?.ToString();
        if (!int.TryParse(indexStr, out var idx) || idx < 0)
        {
            _selectedIndex = -1;
            await OnUnitSelected.InvokeAsync(null);
            return;
        }

        _selectedIndex = idx;
        var unit = FactionUnits?.Units.ElementAtOrDefault(idx);
        await OnUnitSelected.InvokeAsync(unit);
    }
}
