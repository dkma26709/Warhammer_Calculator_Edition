@using Warhammer.Models.Domain
@using Warhammer.Models.Enums
@using Warhammer.Services
@inject IGameDataRepository Repo

<div class="mb-3">
    <label class="form-label small text-body-secondary" for="@($"{_id}-faction")">Faction</label>
    <select id="@($"{_id}-faction")" class="form-select form-select-sm" value="@SelectedFactionKey"
            @onchange="OnFactionChanged">
        <option value="">-- Select Faction --</option>
        @foreach (var faction in Repo.AllFactions)
        {
            <option value="@faction.ToJsonKey()">@faction.ToDisplayName()</option>
        }
    </select>
</div>

@if (FactionUnits != null)
{
    <div class="mb-2">
        <label class="form-label small text-body-secondary" for="@($"{_id}-category")">Category</label>
        <select id="@($"{_id}-category")" class="form-select form-select-sm" value="@_categoryFilter"
                @onchange="OnCategoryChanged">
            <option value="">All</option>
            @foreach (var cat in Categories)
            {
                <option value="@cat">@cat</option>
            }
        </select>
    </div>

    <div class="mb-3">
        <label class="form-label small text-body-secondary" for="@($"{_id}-unit")">Unit</label>
        <select id="@($"{_id}-unit")" class="form-select form-select-sm" value="@_selectedIndex"
                @onchange="OnUnitChanged">
            <option value="-1">-- Select Unit --</option>
            @foreach (var (unit, idx) in FilteredUnitsWithIndex)
            {
                <option value="@idx">@GetDisplayName(unit)</option>
            }
        </select>
    </div>
}

@code {
    // Several selectors can share a page (attacker and defender), so each labels its own ids.
    private readonly string _id = $"unit-selector-{Guid.NewGuid():N}"[..22];

    [Parameter] public string? SelectedFactionKey { get; set; }
    [Parameter] public EventCallback<string> OnFactionSelected { get; set; }
    [Parameter] public IReadOnlyList<Unit>? FactionUnits { get; set; }
    [Parameter] public string? SelectedUnitName { get; set; }
    [Parameter] public EventCallback<Unit?> OnUnitSelected { get; set; }

    private string? _categoryFilter;
    private int _selectedIndex = -1;

    private IEnumerable<string> Categories =>
        FactionUnits?.Select(u => u.Category.ToJsonKey()).Distinct().OrderBy(c => c)
        ?? Enumerable.Empty<string>();

    private IEnumerable<(Unit Unit, int Index)> FilteredUnitsWithIndex
    {
        get
        {
            if (FactionUnits == null) return [];
            return FactionUnits
                .Select((u, i) => (Unit: u, Index: i))
                .Where(x => _categoryFilter == null || x.Unit.Category.ToJsonKey() == _categoryFilter)
                .OrderBy(x => x.Unit.Category)
                .ThenBy(x => x.Unit.Name);
        }
    }

    private HashSet<string>? _duplicateNames;

    private HashSet<string> DuplicateNames
    {
        get
        {
            if (_duplicateNames != null) return _duplicateNames;
            if (FactionUnits == null) return _duplicateNames = [];
            _duplicateNames = FactionUnits
                .GroupBy(u => u.Name)
                .Where(g => g.Count() > 1)
                .Select(g => g.Key)
                .ToHashSet();
            return _duplicateNames;
        }
    }

    private string GetDisplayName(Unit unit)
    {
        if (!DuplicateNames.Contains(unit.Name))
            return unit.Name;

        // Disambiguate with equipment summary and points
        var parts = new List<string>();
        var equipment = unit.RawEntry.Equipment;
        if (!string.IsNullOrEmpty(equipment))
        {
            var firstEquip = equipment.Split('\n')[0];
            if (firstEquip.Length > 30) firstEquip = firstEquip[..30] + "...";
            parts.Add(firstEquip);
        }
        if (unit.BaseModelCost > 0)
            parts.Add($"{unit.BaseModelCost}pts");
        if (unit.BaseModel.TroopType.BaseType == BaseTroopType.Cavalry)
            parts.Add("Cavalry");

        return parts.Count > 0 ? $"{unit.Name} ({string.Join(", ", parts)})" : unit.Name;
    }

    private IReadOnlyList<Unit>? _previousFactionUnits;

    protected override void OnParametersSet()
    {
        if (FactionUnits != _previousFactionUnits)
        {
            _previousFactionUnits = FactionUnits;
            _categoryFilter = null;
            _selectedIndex = -1;
            _duplicateNames = null;
        }
        else if (SelectedUnitName == null && _selectedIndex >= 0)
        {
            _selectedIndex = -1;
        }
    }

    private async Task OnFactionChanged(ChangeEventArgs e)
    {
        var value = e.Value?.ToString();
        await OnFactionSelected.InvokeAsync(value ?? "");
    }

    private async Task OnCategoryChanged(ChangeEventArgs e)
    {
        var value = e.Value?.ToString();
        _categoryFilter = string.IsNullOrEmpty(value) ? null : value;
    }

    private async Task OnUnitChanged(ChangeEventArgs e)
    {
        var indexStr = e.Value?.ToString();
        if (!int.TryParse(indexStr, out var idx) || idx < 0)
        {
            _selectedIndex = -1;
            await OnUnitSelected.InvokeAsync(null);
            return;
        }

        _selectedIndex = idx;
        var unit = FactionUnits?.Count > idx ? FactionUnits[idx] : null;
        await OnUnitSelected.InvokeAsync(unit);
    }
}
