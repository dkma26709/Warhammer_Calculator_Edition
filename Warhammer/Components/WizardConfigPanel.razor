@using Warhammer.Models.Domain
@using Warhammer.Models.Json

@if (Configuration != null && Configuration.IsWizardCapable && AvailableLores.Count > 0)
{
    <div class="mb-3 border border-secondary rounded p-2">
        <label class="form-label small text-body-secondary">Wizard</label>
        @if (!string.IsNullOrWhiteSpace(Configuration.UnitEntry.Magic))
        {
            <div class="text-body-secondary mb-1" style="font-size: 0.75rem;">@Configuration.UnitEntry.Magic.Split('\n')[0]</div>
        }
        <div class="row g-2">
            <div class="col-4">
                <label class="form-label small text-body-secondary mb-0">Level</label>
                <select class="form-select form-select-sm" value="@Configuration.Loadout.WizardLevel"
                        @onchange="OnWizardLevelChanged">
                    @for (int lvl = 1; lvl <= 4; lvl++)
                    {
                        <option value="@lvl">@lvl</option>
                    }
                </select>
            </div>
            <div class="col-8">
                <label class="form-label small text-body-secondary mb-0">Lore</label>
                <select class="form-select form-select-sm" value="@(Configuration.Loadout.SelectedLore ?? "")"
                        @onchange="OnLoreChanged">
                    <option value="">— Select lore —</option>
                    @foreach (var lore in AvailableLores)
                    {
                        <option value="@lore.Name">@Display(lore.Name)</option>
                    }
                </select>
            </div>
        </div>

        @if (SelectedLoreEntry != null)
        {
            var spellsPicked = Configuration.Loadout.SelectedSpells.Count;
            var atLimit = spellsPicked >= Configuration.Loadout.WizardLevel;
            <div class="mt-2">
                <label class="form-label small text-body-secondary mb-1">
                    Spells (@spellsPicked / @Configuration.Loadout.WizardLevel)
                </label>
                @foreach (var spell in SelectedLoreEntry.Spells)
                {
                    var checkedNow = Configuration.Loadout.SelectedSpells.Contains(spell.Name);
                    var disabled = !checkedNow && atLimit;
                    <div class="form-check small">
                        <input class="form-check-input" type="checkbox"
                               id="@(_id + "-spell-" + spell.Name.GetHashCode())"
                               checked="@checkedNow"
                               disabled="@disabled"
                               @onchange="e => OnSpellToggled(spell.Name, (bool)(e.Value ?? false))" />
                        <label class="form-check-label" for="@(_id + "-spell-" + spell.Name.GetHashCode())" title="@spell.Text">
                            @Display(spell.Name)
                            @if (!string.IsNullOrEmpty(spell.Level)) { <span class="text-body-secondary"> (@LevelLabel(spell.Level))</span> }
                            @if (!string.IsNullOrEmpty(spell.Cast)) { <span class="text-body-secondary"> cast @spell.Cast</span> }
                        </label>
                    </div>
                }
            </div>
        }
    </div>
}

@code {
    [Parameter] public UnitConfiguration? Configuration { get; set; }
    [Parameter] public EventCallback<UnitConfiguration> ConfigurationChanged { get; set; }

    /// <summary>The lores the faction's wizards may use — the book's own, then the rulebook's.</summary>
    [Parameter] public IReadOnlyList<LoreEntry>? Lores { get; set; }

    private string _id = Guid.NewGuid().ToString("N")[..8];

    private IReadOnlyList<LoreEntry> AvailableLores => Lores ?? [];

    private LoreEntry? SelectedLoreEntry =>
        Configuration?.Loadout.SelectedLore == null
            ? null
            : AvailableLores.FirstOrDefault(l => string.Equals(l.Name, Configuration.Loadout.SelectedLore, StringComparison.OrdinalIgnoreCase));

    private static string Display(string name) => FactionUpgrades.TitleCase(name);

    /// <summary>"1" prints as "L1"; the two unnumbered kinds print as the book names them.</summary>
    private static string LevelLabel(string level) => int.TryParse(level, out _) ? $"L{level}" : level;

    private async Task OnWizardLevelChanged(ChangeEventArgs e)
    {
        if (Configuration == null) return;
        if (int.TryParse(e.Value?.ToString(), out var lvl) && lvl is >= 1 and <= 4)
        {
            Configuration.Loadout.WizardLevel = lvl;
            // Drop any spells that now exceed the new lower cap.
            while (Configuration.Loadout.SelectedSpells.Count > lvl)
                Configuration.Loadout.SelectedSpells.RemoveAt(Configuration.Loadout.SelectedSpells.Count - 1);
        }
        await ConfigurationChanged.InvokeAsync(Configuration);
    }

    private async Task OnLoreChanged(ChangeEventArgs e)
    {
        if (Configuration == null) return;
        var name = e.Value?.ToString();
        Configuration.Loadout.SelectedLore = string.IsNullOrEmpty(name) ? null : name;
        Configuration.Loadout.SelectedSpells.Clear();
        await ConfigurationChanged.InvokeAsync(Configuration);
    }

    private async Task OnSpellToggled(string spellName, bool isChecked)
    {
        if (Configuration == null) return;
        if (isChecked)
        {
            if (Configuration.Loadout.SelectedSpells.Count >= Configuration.Loadout.WizardLevel) return;
            if (!Configuration.Loadout.SelectedSpells.Contains(spellName))
                Configuration.Loadout.SelectedSpells.Add(spellName);
        }
        else
        {
            Configuration.Loadout.SelectedSpells.Remove(spellName);
        }
        await ConfigurationChanged.InvokeAsync(Configuration);
    }
}
