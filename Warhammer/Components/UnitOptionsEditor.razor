@using Warhammer.Models.Domain
@using Warhammer.Models.Enums
@using Warhammer.Models.Json
@using Warhammer.Services

@inject IGameDataRepository Repo

@* Weapon choice plus every option group the book prints for the entry: equipment, mounts,
   wizard levels, special rules, upgrades and faction upgrade families. Selections are written
   to Configuration.SelectedWeapon / Configuration.Selections / Loadout.SelectedFactionUpgrades.
   Command, banners, magic items and the battle standard have panels of their own. *@

@if (Unit != null && Configuration != null)
{
    @* ── Weapons ── *@
    @if (AvailableWeapons.Count > 1)
    {
        <div class="mb-2">
            <label class="form-label small text-body-secondary">Fight with</label>
            <select class="form-select form-select-sm" value="@Configuration.SelectedWeaponKey"
                    @onchange="OnWeaponChanged">
                @foreach (var (key, name, cost) in AvailableWeapons)
                {
                    <option value="@key.ToJsonKey()">@name @cost</option>
                }
            </select>
        </div>
    }

    @* ── Option groups, in the book's order; a group a taken choice unlocks follows its parent ── *@
    @foreach (var group in Configuration.ActiveGroups())
    {
        var kind = group.GetKind();
        if (kind is OptionKind.Command or OptionKind.MagicStandard or OptionKind.MagicItems or OptionKind.BattleStandard)
            continue;
        if (kind == OptionKind.FactionUpgrade)
            continue;

        var choices = group.Choices.Where(c => c.AppliesToProfile(Configuration.SelectedProfileId)).ToList();
        if (choices.Count == 0) continue;

        var mode = group.GetSelectMode();
        <div class="mb-2" @key="group.Id">
            @if (mode == SelectMode.Count)
            {
                <label class="form-label small text-body-secondary mb-0">@GroupLabel(group)</label>
                @foreach (var choice in choices)
                {
                    var max = Configuration.MaxCountOf(choice);
                    <div class="d-flex align-items-center gap-2 small">
                        <input type="number" class="form-control form-control-sm" style="width: 5rem;"
                               min="0" max="@(max == int.MaxValue ? 99 : max)"
                               value="@Configuration.Selections.CountOf(group.Id, choice.Id)"
                               @onchange="e => OnCountChanged(group, choice, e)" />
                        <span>@choice.Name @FormatCost(choice)@MaxHint(max)</span>
                    </div>
                }
            }
            else if (choices.Count == 1 || mode == SelectMode.Any)
            {
                @if (choices.Count > 1)
                {
                    <label class="form-label small text-body-secondary mb-0">@GroupLabel(group)</label>
                }
                @foreach (var choice in choices)
                {
                    var inputId = $"{_id}-{group.Id}-{choice.Id}";
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="@inputId"
                               checked="@Configuration.Selections.IsSelected(group.Id, choice.Id)"
                               @onchange="e => OnToggled(group, choice, (bool)(e.Value ?? false))" />
                        <label class="form-check-label small" for="@inputId">
                            @choice.Name @FormatCost(choice)
                            @if (choice.Condition != null)
                            {
                                <span class="text-body-secondary"> (@choice.Condition)</span>
                            }
                        </label>
                    </div>
                }
            }
            else
            {
                <label class="form-label small text-body-secondary">@GroupLabel(group)</label>
                <select class="form-select form-select-sm"
                        value="@(Configuration.Selections.SingleIn(group.Id) ?? "")"
                        @onchange="e => OnSelected(group, e)">
                    <option value="">— None —</option>
                    @foreach (var choice in choices)
                    {
                        <option value="@choice.Id">
                            @choice.Name @FormatCost(choice)@(choice.Condition != null ? $" ({choice.Condition})" : "")
                        </option>
                    }
                </select>
            }
            @if (group.Condition != null)
            {
                <div class="text-body-secondary" style="font-size: 0.75rem;">@group.Condition</div>
            }
        </div>
    }

    @* ── Faction upgrade families: the book's own chapters — orders, spawnings, runes ── *@
    @foreach (var offer in Configuration.OfferedFamilies)
    {
        var entries = FamilyEntries(offer.Family);
        if (entries.Count == 0) continue;

        var picks = PicksIn(offer.Family);
        <div class="mb-3 border border-secondary rounded p-2" @key="offer.Family">
            <label class="form-label small text-body-secondary">
                @FamilyTitle(offer.Family) (@FamilyCostSuffix(offer, picks))
            </label>
            @foreach (var entry in entries)
            {
                var inputId = $"{_id}-fup-{entry.Id}";
                var (points, perModel) = ResolveEntryCost(entry);
                <div class="form-check small">
                    <input class="form-check-input" type="checkbox" id="@inputId"
                           checked="@picks.Any(p => p.Id == entry.Id)"
                           @onchange="e => OnFactionUpgradeToggled(offer, entry, points, perModel, (bool)(e.Value ?? false))" />
                    <label class="form-check-label" for="@inputId" title="@entry.Text">
                        @FactionUpgrades.TitleCase(entry.Name)
                        @if (entry.Group != null)
                        {
                            <span class="text-body-secondary"> · @FactionUpgrades.TitleCase(entry.Group)</span>
                        }
                        @if (offer.Rate is null)
                        {
                            <span class="text-body-secondary"> (@EntryCostLabel(entry, points, perModel))</span>
                        }
                        @if (entry.Only != null)
                        {
                            <span class="text-body-secondary"> [@entry.Only]</span>
                        }
                    </label>
                </div>
            }
        </div>
    }
}

@code {
    [Parameter] public Unit? Unit { get; set; }
    [Parameter] public UnitConfiguration? Configuration { get; set; }
    [Parameter] public EventCallback<UnitConfiguration> ConfigurationChanged { get; set; }

    /// <summary>The unit's army book, for its upgrade chapters.</summary>
    [Parameter] public FactionData? Faction { get; set; }

    private readonly string _id = Guid.NewGuid().ToString("N")[..8];

    // ─── Labels ──────────────────────────────────────────────────

    /// <summary>
    /// A menu's heading. The bundle names a group by what it offers — "melee-weapon",
    /// "armour", "mount" — because the printed line is the same "May choose one of the
    /// following:" for all of them.
    /// </summary>
    private static string GroupLabel(OptionGroup group)
    {
        if (group.Choices.Count == 1 && group.GetSelectMode() != SelectMode.Count)
            return group.Choices[0].Name;

        var words = group.Id.Replace('-', ' ');
        words = System.Text.RegularExpressions.Regex.Replace(words, @"\s\d+$", "");
        return char.ToUpperInvariant(words[0]) + words[1..];
    }

    private static string FormatCost(OptionChoice choice)
    {
        if (choice.Points is null) return "";
        var cost = choice.Points.Value;
        if (cost == 0) return "(free)";
        var pts = cost % 1 == 0 ? cost.ToString("F0") : cost.ToString("G");
        if (choice.Per != null) return $"(+{pts} pts/{choice.Per})";
        return choice.PerModel ? $"(+{pts} pts/model)" : $"(+{pts} pts)";
    }

    private static string MaxHint(int max) => max == int.MaxValue ? "" : $" (up to {max})";

    // ─── Faction upgrades ────────────────────────────────────────

    private List<UpgradeEntry> FamilyEntries(string family) =>
        Faction is null ? [] : FactionUpgrades.InFamily(Faction.Upgrades, family).ToList();

    private string FamilyTitle(string family) =>
        Faction is null ? family : FactionUpgrades.FamilyTitle(Faction.Upgrades, family);

    private List<SelectedFactionUpgrade> PicksIn(string family) =>
        Configuration!.Loadout.SelectedFactionUpgrades.TryGetValue(family, out var list) ? list : [];

    private (double Points, bool PerModel) ResolveEntryCost(UpgradeEntry entry) =>
        FactionUpgrades.ResolveCost(entry.Cost, Configuration!.TroopType.IsCharacter, Configuration.TroopType.BaseType);

    private static string EntryCostLabel(UpgradeEntry entry, double points, bool perModel)
    {
        if (entry.Cost is null) return "no cost listed";
        if (points == 0) return "free";
        var pts = points % 1 == 0 ? points.ToString("F0") : points.ToString("G");
        return perModel ? $"{pts} pts/model" : $"{pts} pts";
    }

    private string FamilyCostSuffix(OfferedFamily offer, List<SelectedFactionUpgrade> picks)
    {
        if (offer.Rate is { } rate)
        {
            var pts = rate % 1 == 0 ? rate.ToString("F0") : rate.ToString("G");
            return offer.RatePerModel ? $"+{pts} pt/model each" : $"+{pts} pts each";
        }

        double spent = picks.Sum(p => p.PointsCost);
        if (offer.ThroughMagicItems) return $"{spent:F0} pts, from the magic item allowance";
        if (offer.PointsLimit is { } cap) return $"{spent:F0} / {cap} pts";
        return "points as listed";
    }

    private async Task OnFactionUpgradeToggled(OfferedFamily offer, UpgradeEntry entry, double points, bool perModel, bool isChecked)
    {
        if (Configuration is null) return;
        if (!Configuration.Loadout.SelectedFactionUpgrades.TryGetValue(offer.Family, out var list))
        {
            list = new List<SelectedFactionUpgrade>();
            Configuration.Loadout.SelectedFactionUpgrades[offer.Family] = list;
        }

        if (isChecked && list.All(p => p.Id != entry.Id))
        {
            double cost = perModel ? points * Configuration.ModelCount : points;
            list.Add(new SelectedFactionUpgrade(entry.Id, entry.Name, cost));
        }
        else if (!isChecked)
        {
            list.RemoveAll(p => p.Id == entry.Id);
        }

        await ConfigurationChanged.InvokeAsync(Configuration);
    }

    // ─── Available weapons (for weapon dropdown) ─────────────────

    private List<(CloseCombatWeaponKey Key, string Name, string Cost)> AvailableWeapons
    {
        get
        {
            if (Configuration == null) return [];
            var weapons = new List<(CloseCombatWeaponKey Key, string Name, string Cost)>();
            var seen = new HashSet<CloseCombatWeaponKey>();

            foreach (var key in Configuration.BaseWeaponKeys)
            {
                if (!seen.Add(key)) continue;
                var w = Repo.GetWeapon(key);
                if (w != null) weapons.Add((key, w.Name, ""));
            }

            foreach (var group in Configuration.ActiveGroups())
            {
                if (!group.IsKind(OptionKind.Equipment)) continue;
                foreach (var choice in group.Choices)
                {
                    if (!choice.AppliesToProfile(Configuration.SelectedProfileId)) continue;
                    foreach (var name in EquipmentParser.SplitChoiceName(choice.Name))
                    {
                        if (EquipmentParser.TryNormalize(name, out var normalized, out bool isWeapon)
                            && isWeapon
                            && CloseCombatWeaponKeyExtensions.TryFromJsonKey(normalized, out var enumKey)
                            && seen.Add(enumKey))
                        {
                            var w = Repo.GetWeapon(enumKey);
                            if (w != null) weapons.Add((enumKey, w.Name, FormatCost(choice)));
                        }
                    }
                }
            }

            if (weapons.Count == 0)
                weapons.Add((CloseCombatWeaponKey.HandWeapon, "HAND WEAPON", ""));

            return weapons;
        }
    }

    // ─── Event handlers ──────────────────────────────────────────

    /// <summary>
    /// Picking a weapon to fight with also takes the option that grants it, so the points and
    /// the sheet follow the choice; picking the base weapon clears those options.
    /// </summary>
    private async Task OnWeaponChanged(ChangeEventArgs e)
    {
        if (Configuration == null) return;
        var weaponKey = e.Value?.ToString() ?? "handWeapon";
        Configuration.SelectedWeaponKey = weaponKey;

        foreach (var group in Configuration.ActiveGroups().ToList())
        {
            if (!group.IsKind(OptionKind.Equipment)) continue;

            bool groupHasCCWeapons = group.Choices.Any(c =>
                EquipmentParser.SplitChoiceName(c.Name).Any(n =>
                    EquipmentParser.TryNormalize(n, out var k, out bool isW)
                    && isW && CloseCombatWeaponKeyExtensions.TryFromJsonKey(k, out _)));
            if (!groupHasCCWeapons) continue;

            var match = group.Choices.FirstOrDefault(c =>
                c.AppliesToProfile(Configuration.SelectedProfileId)
                && EquipmentParser.SplitChoiceName(c.Name).Any(n =>
                    EquipmentParser.TryNormalize(n, out var k, out _) && k == weaponKey));

            if (match != null)
            {
                if (group.GetSelectMode() == SelectMode.One)
                    Configuration.Selections.SelectOne(group.Id, match.Id);
                else
                    Configuration.Selections.Toggle(group.Id, match.Id, true);
            }
            else if (group.GetSelectMode() == SelectMode.One)
            {
                Configuration.Selections.Clear(group.Id);
            }
        }

        await ConfigurationChanged.InvokeAsync(Configuration);
    }

    private async Task OnToggled(OptionGroup group, OptionChoice choice, bool selected)
    {
        if (Configuration == null) return;
        if (group.GetSelectMode() == SelectMode.One)
            Configuration.Selections.SelectOne(group.Id, selected ? choice.Id : null);
        else
            Configuration.Selections.Toggle(group.Id, choice.Id, selected);
        await ConfigurationChanged.InvokeAsync(Configuration);
    }

    private async Task OnSelected(OptionGroup group, ChangeEventArgs e)
    {
        if (Configuration == null) return;
        var id = e.Value?.ToString();
        Configuration.Selections.SelectOne(group.Id, string.IsNullOrEmpty(id) ? null : id);
        await ConfigurationChanged.InvokeAsync(Configuration);
    }

    private async Task OnCountChanged(OptionGroup group, OptionChoice choice, ChangeEventArgs e)
    {
        if (Configuration == null) return;
        var count = int.TryParse(e.Value?.ToString(), out var v) ? v : 0;
        count = Math.Clamp(count, 0, Configuration.MaxCountOf(choice));
        Configuration.Selections.Set(group.Id, choice.Id, count);
        await ConfigurationChanged.InvokeAsync(Configuration);
    }
}
