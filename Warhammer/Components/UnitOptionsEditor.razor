@using Warhammer.Models.Domain
@using Warhammer.Models.Enums
@using Warhammer.Models.Json
@using Warhammer.Services

@inject IGameDataRepository Repo

@* A unit's options, in the sections OptionLayout puts them: weapons, armour, other equipment,
   mount, upgrades. Selections are written to Configuration.SelectedWeapon / SelectedUpgrades.
   The calculator picks the weapon a unit fights with; an army list buys weapons instead, so
   ForArmyList gives every weapon group its own control and fights with what was bought. *@

@if (Unit != null && Configuration != null)
{
    @if (!ForArmyList && AvailableWeapons.Count > 1)
    {
        <div class="mb-2">
            <label class="form-label small text-body-secondary">Fight with</label>
            <select class="form-select form-select-sm" value="@Configuration.SelectedWeaponKey"
                    @onchange="OnWeaponChanged">
                @foreach (var (key, name, cost) in AvailableWeapons)
                {
                    <option value="@key.ToJsonKey()">@name @cost</option>
                }
            </select>
        </div>
    }

    @foreach (var section in _placements.GroupBy(p => p.Section))
    {
        @if (ForArmyList)
        {
            <h4 class="wr-cat-title mt-3 mb-2">@SectionTitle(section.Key)</h4>
        }
        @foreach (var placement in section)
        {
            @RenderOptionControl(placement)
        }
    }
}

@code {
    [Parameter] public Unit? Unit { get; set; }
    [Parameter] public UnitConfiguration? Configuration { get; set; }
    [Parameter] public EventCallback<UnitConfiguration> ConfigurationChanged { get; set; }
    [Parameter] public FactionExtrasData? FactionExtras { get; set; }

    /// <summary>
    /// True in the Army Builder: weapon groups get their own controls in place of the
    /// calculator's "Fight with", and the sections are headed.
    /// </summary>
    [Parameter] public bool ForArmyList { get; set; }

    private string _id = Guid.NewGuid().ToString("N")[..8];

    private List<OptionPlacement> _placements = [];

    protected override void OnParametersSet()
    {
        // "Fight with" stands in for the groups that hold nothing but close combat weapons,
        // and a faction upgrade with no entries in the extras has nothing to offer.
        _placements = OptionLayout.Arrange(Unit?.Options)
            .Where(p => ForArmyList || !OptionLayout.IsCloseCombatWeaponGroup(p.Option))
            .Where(p => !p.Option.IsType(OptionType.FactionUpgrade) || HasFactionUpgradeCategory(p.Option))
            .ToList();
    }

    private static string SectionTitle(OptionSection section) => section switch
    {
        OptionSection.Weapons => "Weapons",
        OptionSection.Armour => "Armour",
        OptionSection.Equipment => "Equipment",
        OptionSection.Mount => "Mount",
        _ => "Upgrades",
    };

    // ─── Unified option rendering ────────────────────────────────

    private RenderFragment RenderOptionControl(OptionPlacement placement) => builder =>
    {
        var (idx, option, label) = (placement.Index, placement.Option, placement.Label);
        switch (option.GetOptionType())
        {
            case OptionType.Equipment:
                RenderEquipmentOption(builder, idx, option, label);
                break;
            case OptionType.Mount:
                RenderChoicesDropdown(builder, idx, option, label);
                break;
            case OptionType.Upgrade when option.SubOptions != null:
                RenderSubOptionsDropdown(builder, idx, option, label);
                break;
            case OptionType.BlessedSpawning or OptionType.FactionUpgrade
                when HasFactionUpgradeCategory(option):
                RenderFactionUpgradeMultiSelect(builder, option);
                break;
            case OptionType.FactionUpgrade:
                // No data for the category — nothing meaningful to offer.
                break;
            case OptionType.Upgrade or OptionType.WizardUpgrade or OptionType.BlessedSpawning:
                RenderFlatCheckbox(builder, idx, option, label);
                break;
        }
    };

    private bool HasFactionUpgradeCategory(UnitOption option)
    {
        var category = UnitConfiguration.FactionUpgradeCategoryFor(option);
        if (category is null || FactionExtras?.FactionUpgrades is null) return false;
        return FactionExtras.FactionUpgrades.TryGetValue(category, out var entries) && entries.Count > 0;
    }

    private void RenderFactionUpgradeMultiSelect(
        Microsoft.AspNetCore.Components.Rendering.RenderTreeBuilder builder,
        UnitOption option)
    {
        if (Configuration is null || FactionExtras?.FactionUpgrades is null) return;
        var category = UnitConfiguration.FactionUpgradeCategoryFor(option);
        if (category is null) return;
        if (!FactionExtras.FactionUpgrades.TryGetValue(category, out var entries)) return;

        var selected = Configuration.Loadout.SelectedFactionUpgrades.TryGetValue(category, out var list)
            ? list
            : (Configuration.Loadout.SelectedFactionUpgrades[category] = new List<SelectedFactionUpgrade>());

        var label = FormatUpgradeCategory(category);
        // No rate on the option means each upgrade is priced individually (characters).
        var costSuffix = option.Points is null
            ? "points as listed"
            : option.PerModel == true
                ? $"+{option.Points:F0} pt/model each"
                : $"+{option.Points:F0} pts each";
        var max = Configuration.MaxPicks(category);
        // Still checkboxes, so the one pick can be unticked to none.
        var choiceHint = max switch { 1 => "choose one, ", > 1 => $"choose up to {max}, ", _ => "" };

        builder.OpenElement(0, "div");
        builder.AddAttribute(1, "class", "mb-3 border border-secondary rounded p-2");

        builder.OpenElement(2, "label");
        builder.AddAttribute(3, "class", "form-label small text-body-secondary");
        builder.AddContent(4, $"{label} ({choiceHint}{costSuffix})");
        builder.CloseElement();

        int seq = 10;
        foreach (var entry in entries)
        {
            var checkedNow = selected.Any(p => p.Name == entry.Name);
            var resolved = Configuration.ResolveUpgradePrice(entry.Points);
            // Not offered to this troop type, but a pick already made stays listed so it can be unticked.
            if (resolved is null && !checkedNow) continue;
            var price = resolved ?? new UpgradePrice(0, false);
            // A ticked entry stays enabled so it can always be unticked.
            var canTick = checkedNow || Configuration.PicksAfterTick(
                category, new SelectedFactionUpgrade(entry.Name, price.Points, price.PerModel)) is not null;
            var inputId = _id + "-fup-" + entry.Name.GetHashCode();

            builder.OpenElement(seq++, "div");
            builder.AddAttribute(seq++, "class", "form-check small");

            builder.OpenElement(seq++, "input");
            builder.AddAttribute(seq++, "class", "form-check-input");
            builder.AddAttribute(seq++, "type", "checkbox");
            builder.AddAttribute(seq++, "id", inputId);
            builder.AddAttribute(seq++, "checked", checkedNow);
            // false and null omit the attribute, so a change in fit does not shift the sequence numbers.
            builder.AddAttribute(seq++, "disabled", !canTick);
            builder.AddAttribute(seq++, "title", canTick ? null : $"Up to {max} {label}");
            builder.AddAttribute(seq++, "onchange",
                Microsoft.AspNetCore.Components.EventCallback.Factory.Create<ChangeEventArgs>(
                    this, async e => await OnFactionUpgradeToggled(
                        category, entry.Name, price, (bool)(e.Value ?? false))));
            builder.CloseElement();

            builder.OpenElement(seq++, "label");
            builder.AddAttribute(seq++, "class", canTick ? "form-check-label" : "form-check-label text-body-secondary");
            builder.AddAttribute(seq++, "for", inputId);
            builder.AddContent(seq++, entry.Name);
            if (UpgradePrice.IsTiered(entry.Points))
            {
                // The price for this unit's tier, not the whole multi-line table.
                if (resolved is not null) builder.AddContent(seq++, $" ({price.Label})");
            }
            else if (!string.IsNullOrEmpty(entry.Points) && entry.Points.Any(char.IsDigit))
            {
                builder.AddContent(seq++, $" ({entry.Points} pts)");
            }
            builder.CloseElement();

            builder.CloseElement();
        }
        builder.CloseElement();
    }

    private async Task OnFactionUpgradeToggled(string category, string name, UpgradePrice price, bool isChecked)
    {
        if (Configuration is null) return;
        Configuration.ToggleFactionUpgrade(
            category, new SelectedFactionUpgrade(name, price.Points, price.PerModel), isChecked);
        await ConfigurationChanged.InvokeAsync(Configuration);
    }

    private static string FormatUpgradeCategory(string category) => category switch
    {
        "blessed_spawnings" => "Blessed Spawnings",
        _ => category.Replace('_', ' '),
    };

    private void RenderEquipmentOption(Microsoft.AspNetCore.Components.Rendering.RenderTreeBuilder builder, int idx, UnitOption option, string label)
    {
        if (option.Choices == null) return;

        if (option.Choices.Count == 1)
        {
            // Single choice → checkbox, headed by the item itself
            var choice = option.Choices[0];
            var isSelected = Configuration!.SelectedUpgrades.TryGetValue(idx, out var selIdx) && selIdx == 0;
            var costLabel = OptionLayout.CostLabel(choice);
            var capturedIdx = idx;

            builder.OpenElement(0, "div");
            builder.AddAttribute(1, "class", "mb-2");
            builder.OpenElement(2, "div");
            builder.AddAttribute(3, "class", "form-check");
            builder.OpenElement(4, "input");
            builder.AddAttribute(5, "class", "form-check-input");
            builder.AddAttribute(6, "type", "checkbox");
            builder.AddAttribute(7, "id", $"{_id}-opt-{capturedIdx}");
            builder.AddAttribute(8, "checked", isSelected);
            builder.AddAttribute(9, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(this,
                e => OnUpgradeToggled(capturedIdx, (bool)(e.Value ?? false))));
            builder.CloseElement();
            builder.OpenElement(10, "label");
            builder.AddAttribute(11, "class", "form-check-label small");
            builder.AddAttribute(12, "for", $"{_id}-opt-{capturedIdx}");
            builder.AddContent(13, $"{label} {costLabel}");
            builder.CloseElement();
            builder.CloseElement();
            builder.CloseElement();
        }
        else if (option.AllowsMultipleChoices)
        {
            // "Choose any" / "at least one" → one checkbox per choice
            RenderMultiChoiceCheckboxes(builder, idx, option, label);
        }
        else
        {
            // Multiple choices → dropdown
            var currentChoice = Configuration!.SelectedUpgrades.TryGetValue(idx, out var curIdx) ? curIdx : -1;
            var capturedIdx = idx;

            builder.OpenElement(0, "div");
            builder.AddAttribute(1, "class", "mb-2");
            builder.OpenElement(2, "label");
            builder.AddAttribute(3, "class", "form-label small text-body-secondary");
            builder.AddContent(4, label);
            builder.CloseElement();
            builder.OpenElement(5, "select");
            builder.AddAttribute(6, "class", "form-select form-select-sm");
            builder.AddAttribute(7, "value", currentChoice);
            builder.AddAttribute(8, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(this,
                e => OnUpgradeSelected(capturedIdx, int.TryParse(e.Value?.ToString(), out var v) ? v : -1)));
            builder.OpenElement(9, "option");
            builder.AddAttribute(10, "value", -1);
            builder.AddContent(11, "— None —");
            builder.CloseElement();
            for (int ci = 0; ci < option.Choices.Count; ci++)
            {
                var choice = option.Choices[ci];
                builder.OpenElement(12, "option");
                builder.AddAttribute(13, "value", ci);
                builder.AddContent(14, $"{OptionLayout.ChoiceName(choice)} {OptionLayout.CostLabel(choice)}");
                builder.CloseElement();
            }
            builder.CloseElement();
            builder.CloseElement();
        }
    }

    private void RenderMultiChoiceCheckboxes(
        Microsoft.AspNetCore.Components.Rendering.RenderTreeBuilder builder,
        int idx, UnitOption option, string label)
    {
        if (option.Choices == null) return;
        var selectedNow = Configuration!.SelectedChoicesIn(idx).ToHashSet();
        var capturedIdx = idx;

        builder.OpenElement(0, "div");
        builder.AddAttribute(1, "class", "mb-2");
        builder.OpenElement(2, "label");
        builder.AddAttribute(3, "class", "form-label small text-body-secondary mb-0");
        builder.AddContent(4, label);
        builder.CloseElement();

        int seq = 10;
        for (int ci = 0; ci < option.Choices.Count; ci++)
        {
            var choice = option.Choices[ci];
            var capturedChoice = ci;
            var inputId = $"{_id}-opt-{capturedIdx}-{ci}";

            builder.OpenElement(seq++, "div");
            builder.AddAttribute(seq++, "class", "form-check");
            builder.OpenElement(seq++, "input");
            builder.AddAttribute(seq++, "class", "form-check-input");
            builder.AddAttribute(seq++, "type", "checkbox");
            builder.AddAttribute(seq++, "id", inputId);
            builder.AddAttribute(seq++, "checked", selectedNow.Contains(ci));
            builder.AddAttribute(seq++, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(this,
                e => OnMultiUpgradeToggled(capturedIdx, capturedChoice, (bool)(e.Value ?? false))));
            builder.CloseElement();
            builder.OpenElement(seq++, "label");
            builder.AddAttribute(seq++, "class", "form-check-label small");
            builder.AddAttribute(seq++, "for", inputId);
            builder.AddContent(seq++, $"{OptionLayout.ChoiceName(choice)} {OptionLayout.CostLabel(choice)}");
            builder.CloseElement();
            builder.CloseElement();
        }
        builder.CloseElement();
    }

    private void RenderChoicesDropdown(Microsoft.AspNetCore.Components.Rendering.RenderTreeBuilder builder, int idx, UnitOption option, string label)
    {
        if (option.Choices == null || option.Choices.Count == 0) return;
        var currentChoice = Configuration!.SelectedUpgrades.TryGetValue(idx, out var curIdx) ? curIdx : -1;
        var capturedIdx = idx;

        builder.OpenElement(0, "div");
        builder.AddAttribute(1, "class", "mb-2");
        builder.OpenElement(2, "label");
        builder.AddAttribute(3, "class", "form-label small text-body-secondary");
        builder.AddContent(4, label);
        builder.CloseElement();
        builder.OpenElement(5, "select");
        builder.AddAttribute(6, "class", "form-select form-select-sm");
        builder.AddAttribute(7, "value", currentChoice);
        builder.AddAttribute(8, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(this,
            e => OnUpgradeSelected(capturedIdx, int.TryParse(e.Value?.ToString(), out var v) ? v : -1)));
        builder.OpenElement(9, "option");
        builder.AddAttribute(10, "value", -1);
        builder.AddContent(11, "— None —");
        builder.CloseElement();
        for (int ci = 0; ci < option.Choices.Count; ci++)
        {
            var choice = option.Choices[ci];
            builder.OpenElement(12, "option");
            builder.AddAttribute(13, "value", ci);
            builder.AddContent(14, $"{OptionLayout.ChoiceName(choice)} {OptionLayout.CostLabel(choice)}");
            builder.CloseElement();
        }
        builder.CloseElement();
        builder.CloseElement();
    }

    private void RenderSubOptionsDropdown(Microsoft.AspNetCore.Components.Rendering.RenderTreeBuilder builder, int idx, UnitOption option, string label)
    {
        if (option.SubOptions == null || option.SubOptions.Count == 0) return;
        var currentChoice = Configuration!.SelectedUpgrades.TryGetValue(idx, out var curIdx) ? curIdx : -1;
        var capturedIdx = idx;

        builder.OpenElement(0, "div");
        builder.AddAttribute(1, "class", "mb-2");
        builder.OpenElement(2, "label");
        builder.AddAttribute(3, "class", "form-label small text-body-secondary");
        builder.AddContent(4, label);
        builder.CloseElement();
        builder.OpenElement(5, "select");
        builder.AddAttribute(6, "class", "form-select form-select-sm");
        builder.AddAttribute(7, "value", currentChoice);
        builder.AddAttribute(8, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(this,
            e => OnUpgradeSelected(capturedIdx, int.TryParse(e.Value?.ToString(), out var v) ? v : -1)));
        builder.OpenElement(9, "option");
        builder.AddAttribute(10, "value", -1);
        builder.AddContent(11, "— None —");
        builder.CloseElement();
        for (int si = 0; si < option.SubOptions.Count; si++)
        {
            var sub = option.SubOptions[si];
            var first = sub.Choices?.FirstOrDefault();
            var name = first != null ? OptionLayout.ChoiceName(first) : sub.Upgrade ?? "Option";
            var pts = first?.Points ?? sub.Points ?? 0;
            var perModel = first?.PerModel ?? sub.PerModel ?? false;
            var costLabel = OptionLayout.CostLabel(pts, perModel);
            builder.OpenElement(12, "option");
            builder.AddAttribute(13, "value", si);
            builder.AddContent(14, $"{name} {costLabel}");
            builder.CloseElement();
        }
        builder.CloseElement();
        builder.CloseElement();
    }

    private void RenderFlatCheckbox(Microsoft.AspNetCore.Components.Rendering.RenderTreeBuilder builder, int idx, UnitOption option, string label)
    {
        var isSelected = Configuration!.SelectedUpgrades.TryGetValue(idx, out var selIdx) && selIdx == 0;
        var costLabel = OptionLayout.CostLabel(option.Points ?? 0, option.PerModel ?? false);
        var capturedIdx = idx;

        builder.OpenElement(0, "div");
        builder.AddAttribute(1, "class", "mb-2");
        builder.OpenElement(2, "div");
        builder.AddAttribute(3, "class", "form-check");
        builder.OpenElement(4, "input");
        builder.AddAttribute(5, "class", "form-check-input");
        builder.AddAttribute(6, "type", "checkbox");
        builder.AddAttribute(7, "id", $"{_id}-opt-{capturedIdx}");
        builder.AddAttribute(8, "checked", isSelected);
        builder.AddAttribute(9, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(this,
            e => OnUpgradeToggled(capturedIdx, (bool)(e.Value ?? false))));
        builder.CloseElement();
        builder.OpenElement(10, "label");
        builder.AddAttribute(11, "class", "form-check-label small");
        builder.AddAttribute(12, "for", $"{_id}-opt-{capturedIdx}");
        builder.AddContent(13, $"{label} {costLabel}");
        builder.CloseElement();
        builder.CloseElement();
        builder.CloseElement();
    }

    // ─── Available weapons (for weapon dropdown) ─────────────────

    private List<(CloseCombatWeaponKey Key, string Name, string Cost)> AvailableWeapons
    {
        get
        {
            if (Configuration == null) return [];
            var weapons = new List<(CloseCombatWeaponKey Key, string Name, string Cost)>();
            var seen = new HashSet<CloseCombatWeaponKey>();

            foreach (var key in Configuration.BaseWeaponKeys)
            {
                if (!seen.Add(key)) continue;
                var w = Repo.GetWeapon(key);
                if (w != null) weapons.Add((key, w.Name, ""));
            }

            if (Unit?.Options != null)
            {
                foreach (var option in Unit.Options)
                {
                    if (!option.IsType(OptionType.Equipment) || option.Choices == null) continue;
                    foreach (var choice in option.Choices)
                    {
                        foreach (var name in choice.Name)
                        {
                            if (EquipmentParser.TryNormalize(name, out var normalized, out bool isWeapon)
                                && isWeapon
                                && CloseCombatWeaponKeyExtensions.TryFromJsonKey(normalized, out var enumKey)
                                && seen.Add(enumKey))
                            {
                                var w = Repo.GetWeapon(enumKey);
                                if (w != null) weapons.Add((enumKey, w.Name, OptionLayout.CostLabel(choice)));
                            }
                        }
                    }
                }
            }

            if (weapons.Count == 0)
                weapons.Add((CloseCombatWeaponKey.HandWeapon, "HAND WEAPON", ""));

            return weapons;
        }
    }

    // ─── Event handlers ──────────────────────────────────────────

    private async Task OnWeaponChanged(ChangeEventArgs e)
    {
        if (Configuration == null) return;
        if (CloseCombatWeaponKeyExtensions.TryFromJsonKey(e.Value?.ToString() ?? "", out var key))
            Configuration.FightWith(key);
        await ConfigurationChanged.InvokeAsync(Configuration);
    }

    /// <summary>
    /// Report a change. An army list has no "Fight with", so its entry fights with the weapon
    /// it bought, which the roster then lists first.
    /// </summary>
    private Task NotifyChanged()
    {
        if (ForArmyList) Configuration!.SelectedWeapon = Configuration.ListedWeapon;
        return ConfigurationChanged.InvokeAsync(Configuration);
    }

    private async Task OnUpgradeToggled(int optionIndex, bool selected)
    {
        if (Configuration == null) return;
        if (selected)
            Configuration.SelectedUpgrades[optionIndex] = 0;
        else
            Configuration.SelectedUpgrades.Remove(optionIndex);
        await NotifyChanged();
    }

    private async Task OnMultiUpgradeToggled(int optionIndex, int choiceIndex, bool selected)
    {
        if (Configuration == null) return;
        if (!Configuration.SelectedMultiUpgrades.TryGetValue(optionIndex, out var picks))
        {
            picks = new List<int>();
            // Absorb a pick saved while this group was still a single-select dropdown —
            // the multi entry supersedes SelectedUpgrades for this group from here on.
            if (Configuration.SelectedUpgrades.TryGetValue(optionIndex, out var legacy) && legacy >= 0)
                picks.Add(legacy);
            Configuration.SelectedUpgrades.Remove(optionIndex);
            Configuration.SelectedMultiUpgrades[optionIndex] = picks;
        }

        if (selected && !picks.Contains(choiceIndex)) picks.Add(choiceIndex);
        else if (!selected) picks.Remove(choiceIndex);

        await NotifyChanged();
    }

    private async Task OnUpgradeSelected(int optionIndex, int choiceIndex)
    {
        if (Configuration == null) return;
        if (choiceIndex < 0)
            Configuration.SelectedUpgrades.Remove(optionIndex);
        else
            Configuration.SelectedUpgrades[optionIndex] = choiceIndex;
        await NotifyChanged();
    }
}
