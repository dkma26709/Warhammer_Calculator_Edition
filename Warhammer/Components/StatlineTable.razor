@if (Profile is not null)
{
    <table class="table table-sm table-bordered mt-2">
        <thead>
            <tr>
                <th></th>
                <th>M</th><th>WS</th><th>BS</th><th>S</th><th>T</th>
                <th>W</th><th>I</th><th>A</th><th>Ld</th><th>Save</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td><strong>@Profile.Name</strong></td>
                <td>@Profile.Movement</td>
                <td>@Profile.WeaponSkill</td>
                <td>@Profile.BallisticSkill</td>
                <td>@Profile.Strength</td>
                <td>@Profile.Toughness</td>
                <td>@Profile.Wounds</td>
                <td>@Profile.Initiative</td>
                <td>@Profile.Attacks</td>
                <td>@Profile.Leadership</td>
                <td>@(Profile.ArmorSave.HasValue ? $"{Profile.ArmorSave}+" : "-")</td>
            </tr>
            @if (Profile.Mount is not null)
            {
                <tr>
                    <td><em>@Profile.Mount.Name</em></td>
                    <td>-</td>
                    <td>@Profile.Mount.WeaponSkill</td>
                    <td>-</td>
                    <td>@Profile.Mount.Strength</td>
                    <td>@Profile.Mount.Toughness</td>
                    <td>-</td>
                    <td>@Profile.Mount.Initiative</td>
                    <td>@Profile.Mount.Attacks</td>
                    <td>-</td>
                    <td>-</td>
                </tr>
            }
        </tbody>
    </table>
    <small class="text-muted">@Profile.EquipmentDescription</small>
}

@code {
    [Parameter] public ResolvedUnitProfile? Profile { get; set; }
}
