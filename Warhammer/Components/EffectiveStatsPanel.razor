@using Warhammer.Calculator
@using Warhammer.Calculator.Models
@using Warhammer.Models.Domain
@using Warhammer.Models.Enums
@using Warhammer.Services

@inject IGameDataRepository Repo

@if (Attacker != null && Defender != null)
{
    var atkStats = ComputeStats(Attacker, Defender, isAttackerSide: true);
    var defStats = ComputeStats(Defender, Attacker, isAttackerSide: false);

    <div class="card bg-dark text-light border-secondary mt-3">
        <div class="card-header">
            <h6 class="card-title mb-0">Effective Stats</h6>
        </div>
        <div class="card-body p-2">
            <div class="row g-2">
                <div class="col-6">
                    <h6 class="text-success small mb-1">@(Attacker.ResolvedUnit.Name)</h6>
                    @RenderStats(atkStats)
                </div>
                <div class="col-6">
                    <h6 class="text-danger small mb-1">@(Defender.ResolvedUnit.Name)</h6>
                    @RenderStats(defStats)
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public UnitConfiguration? Attacker { get; set; }
    [Parameter] public UnitConfiguration? Defender { get; set; }
    [Parameter] public ChargeState ChargeState { get; set; }

    private record UnitStats
    {
        public int BaseContact { get; init; }
        public int TotalAttacks { get; init; }
        public int MountAttacks { get; init; }
        public bool HasMount { get; init; }
        public int EffectiveStrength { get; init; }
        public int EffectiveInitiative { get; init; }
        public int ToHitNeeded { get; init; }
        public RollRequirement ToWoundNeeded { get; init; }
        public bool HasPoison { get; init; }
        public int ArmourSave { get; init; }
        public int WardSave { get; init; }
        public int ImpactHits { get; init; }
        public bool IsCharging { get; init; }
    }

    private Weapon ResolveWeapon(UnitConfiguration unit)
    {
        return Repo.GetWeapon(unit.SelectedWeapon) ?? Repo.GetHandWeapon();
    }

    private UnitStats ComputeStats(UnitConfiguration unit, UnitConfiguration opponent, bool isAttackerSide)
    {
        var context = new CombatContext { Charge = ChargeState, CombatRound = 1 };
        bool isCharging = context.IsCharging(isAttackerSide);
        bool isBeingCharged = context.IsCharging(!isAttackerSide);

        // Weapon and weapon rules
        var weapon = ResolveWeapon(unit);

        // Effective initiative
        int effectiveI = weapon.Rules.ApplyToInitiative(
            unit.PrimaryProfile.I ?? 1, isCharging, isBeingCharged, context.CombatRound);

        // Weapon Mighty Blow
        int weaponMB = 0;
        if (weapon.Rules.MightyBlow != null)
        {
            bool applyWeaponMB = ParsedWeaponRules.Holds(
                weapon.Rules.MightyBlowCondition, isCharging, isBeingCharged, context.CombatRound);
            if (applyWeaponMB)
                weaponMB = weapon.Rules.MightyBlow.Value;
        }

        // Effective strength
        int effectiveS = unit.EffectiveStrength(weapon, isCharging, 1, weaponMB);

        // Total attacks
        int totalAttacks = unit.TotalAttacks(isCharging, 1,
            weapon.Rules.ExtraAttacks, weapon.Rules.FightInExtraRanks ?? 0);
        int mountAttacks = unit.MountAttacks();

        // To-hit
        int attackerWS = unit.PrimaryProfile.WS ?? 1;
        int toHitNeeded = Repo.GetToHitRequirement(attackerWS, opponent.BestWS).FirstRoll ?? 6;

        // To-wound
        var toWoundNeeded = Repo.GetToWoundRequirement(effectiveS, opponent.BestT);

        // Armour save (this unit's save vs opponent's attacks)
        var opponentWeapon = ResolveWeapon(opponent);
        bool opponentIsCharging = isBeingCharged;
        bool opponentIsBeingCharged = isCharging;
        int opponentWeaponMB = 0;
        if (opponentWeapon.Rules.MightyBlow != null)
        {
            bool applyOppMB = opponentWeapon.Rules.MightyBlowCondition switch
            {
                WeaponCondition.WhenCharging => opponentIsCharging,
                WeaponCondition.WhenBeingCharged => opponentIsBeingCharged,
                _ => true
            };
            if (applyOppMB)
                opponentWeaponMB = opponentWeapon.Rules.MightyBlow.Value;
        }
        int opponentS = opponent.EffectiveStrength(opponentWeapon, opponentIsCharging, 1, opponentWeaponMB);
        var opponentRules = opponent.EffectiveSpecialRules;
        int opponentAP = opponentRules.ArmourPiercing ?? 0;
        int strengthMod = Repo.GetArmourSaveModifier(opponentS);
        int armourSave = unit.EffectiveArmourSave(opponentS, opponentAP, strengthMod);

        // Ward save (best of ward/regen/parry)
        var unitRules = unit.EffectiveSpecialRules;
        int wardValue = unitRules.WardSave ?? 7;
        int regenValue = unitRules.Regeneration ?? 7;
        int parryValue = unitRules.Parry ?? 7;
        int bestWard = Math.Min(Math.Min(wardValue, regenValue), parryValue);

        // Impact hits
        int impactHits = 0;
        if (isCharging)
        {
            if (unitRules.ImpactHits.HasValue)
                impactHits = unitRules.ImpactHits.Value * unit.ModelsInFrontRank;
            else if (unit.TroopType.BaseType is BaseTroopType.Cavalry or BaseTroopType.MonstrousCavalry)
                impactHits = unit.ModelsInFrontRank;
        }

        // Base contact
        int baseContact = BaseContactCalculator.ModelsInBaseContact(unit, opponent);

        return new UnitStats
        {
            BaseContact = baseContact,
            TotalAttacks = totalAttacks,
            MountAttacks = mountAttacks,
            HasMount = unit.MountProfile != null && unit.TroopType.HasSplitProfile,
            EffectiveStrength = effectiveS,
            EffectiveInitiative = effectiveI,
            ToHitNeeded = toHitNeeded,
            ToWoundNeeded = toWoundNeeded,
            HasPoison = unitRules.PoisonedAttacks,
            ArmourSave = armourSave,
            WardSave = bestWard,
            ImpactHits = impactHits,
            IsCharging = isCharging
        };
    }

    private static RenderFragment RenderStats(UnitStats stats) => __builder =>
    {
        <table class="table table-sm table-dark mb-0" style="font-size: 0.85rem;">
            <tbody>
                <tr>
                    <td class="text-body-secondary">Base Contact</td>
                    <td class="text-end fw-bold">@stats.BaseContact models</td>
                </tr>
                <tr>
                    <td class="text-body-secondary">Attacks</td>
                    <td class="text-end fw-bold">
                        @stats.TotalAttacks
                        @if (stats.HasMount)
                        {
                            <span class="text-body-secondary fw-normal"> (+@stats.MountAttacks mount)</span>
                        }
                    </td>
                </tr>
                <tr>
                    <td class="text-body-secondary">Eff. Strength</td>
                    <td class="text-end fw-bold">@stats.EffectiveStrength</td>
                </tr>
                <tr>
                    <td class="text-body-secondary">Eff. Initiative</td>
                    <td class="text-end fw-bold">@stats.EffectiveInitiative</td>
                </tr>
                <tr>
                    <td class="text-body-secondary">To Hit</td>
                    <td class="text-end fw-bold">@(stats.ToHitNeeded)+</td>
                </tr>
                <tr>
                    <td class="text-body-secondary">To Wound</td>
                    <td class="text-end fw-bold">
                        @stats.ToWoundNeeded
                        @if (stats.HasPoison)
                        {
                            <span class="text-warning fw-normal"> (poison)</span>
                        }
                    </td>
                </tr>
                <tr>
                    <td class="text-body-secondary">Armour Save</td>
                    <td class="text-end fw-bold">@FormatSave(stats.ArmourSave)</td>
                </tr>
                <tr>
                    <td class="text-body-secondary">Ward Save</td>
                    <td class="text-end fw-bold">@FormatSave(stats.WardSave)</td>
                </tr>
                @if (stats.ImpactHits > 0)
                {
                    <tr>
                        <td class="text-body-secondary">Impact Hits</td>
                        <td class="text-end fw-bold">@stats.ImpactHits</td>
                    </tr>
                }
            </tbody>
        </table>
    };

    private static string FormatSave(int save) => save <= 6 ? $"{save}+" : "\u2014";
}
